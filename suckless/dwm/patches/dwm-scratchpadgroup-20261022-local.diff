+	for (i = 0; i < n; i++) {
+		if (i == 0) {
+			x = m->wx, w = mw, h = m->wh;
+		} else {
+			x = m->wx + mw, w = m->ww - mw;
+			h = i == n - 1 ? m->wy + m->wh - y : m->wh / (n - 1);
+		}
+		if (!sp[i]->isfullscreen)
+			resize(sp[i], x, y, w - 2 * sp[i]->bw, h - 2 * sp[i]->bw, 0);
+		if (i)
+			y += h;
+	}
+}
 
