#!/bin/sh
# Used physical memory, read straight from /proc/meminfo so the output does
# not depend on the locale or the `free` version installed. The total is read
# too, but only to reject an impossible reading; the bar shows used alone.
#
# Left-click opens htop. DOTS_PROC_ROOT redirects /proc, for tests only.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${COL_MEM:=#7ebd6f}"

# Left-click: htop in a terminal dwm floats. The block itself re-renders as
# usual -- dwmblocks re-runs it for the click. The helpers (dwm-blockutil) are
# sourced only for a click: this block is polled, and the bar's polled blocks
# are kept to the reads they need.
if [ "$BUTTON" = 1 ] && command -v htop >/dev/null 2>&1; then
	util="${0%/*}/dwm-blockutil"
	[ -r "$util" ] || util="$HOME/.local/bin/dwm-blockutil"
	[ -r "$util" ] && . "$util" && block_term htop htop
fi

awk -v c="$COL_MEM" '
	/^MemTotal:/     { total = $2 }
	/^MemAvailable:/ { avail = $2 }
	END {
		# MemAvailable is absent on kernels older than 3.14. Left
		# unchecked it reads as 0 and the block would claim every byte
		# of RAM is in use, which looks plausible and is wrong.
		if (total <= 0 || avail == "") {
			printf "^c%s^󰍛^d^ n/a\n", c
			exit
		}
		used = total - avail
		printf "^c%s^󰍛^d^ %.1fG\n", c, used / 1048576
	}
' "${DOTS_PROC_ROOT:-/proc}/meminfo"
