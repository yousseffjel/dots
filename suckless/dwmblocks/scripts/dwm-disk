#!/bin/sh
# Free space on the root filesystem, with the colour carrying the urgency.
#
# `df -P` forces the POSIX one-line-per-filesystem format. Without it a long
# device name wraps onto a second line and every column shifts, which is the
# classic way this block starts reporting the wrong number on one machine
# only. Left-click opens / in thunar.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT1:=^c#5294e2^}"
: "${STATUS_WARN:=^c#d9a05b^}"
: "${STATUS_URGENT:=^c#cc5555^}"
: "${STATUS_RESET:=^d^}"

# Thresholds are on USED percent, so they read the same way round as the
# number df prints.
WARN_PCT=85
URGENT_PCT=95

case "$BUTTON" in
1)
	if command -v thunar >/dev/null 2>&1; then
		thunar / >/dev/null 2>&1 &
	fi
	;;
esac

# NR == 2 is the single data row -P guarantees. Strip the % here so the shell
# never has to parse it.
fields=$(df -P -h / 2>/dev/null | awk 'NR == 2 { sub(/%$/, "", $5); print $4, $5 }')

# Empty means df failed or printed no data row -- do not fabricate a reading.
if [ -z "$fields" ]; then
	printf '%sDISK%s n/a\n' "$STATUS_ACCENT1" "$STATUS_RESET"
	exit 0
fi

# Word-splitting is the intent here: two fields, avail then used-percent.
# shellcheck disable=SC2086
set -- $fields
avail=$1
pct=$2

# A non-numeric percent means the format was not what we expect; say so rather
# than letting [ -ge ] fail and print nothing.
case "$pct" in
'' | *[!0-9]*)
	printf '%sDISK%s %s\n' "$STATUS_ACCENT1" "$STATUS_RESET" "$avail"
	exit 0
	;;
esac

if [ "$pct" -ge "$URGENT_PCT" ]; then
	col=$STATUS_URGENT
elif [ "$pct" -ge "$WARN_PCT" ]; then
	col=$STATUS_WARN
else
	col=$STATUS_ACCENT1
fi

printf '%sDISK%s %s free\n' "$col" "$STATUS_RESET" "$avail"
