# Shared helpers for the dwmblocks block scripts. Sourced, never run -- like
# dwm-colors, and installed to ~/.local/bin by the same dwm-* glob
# (install-suckless.sh, and the Makefile's install-scripts target).
#
# A block sources it with the same two-place lookup it uses for dwm-colors.
# When it is missing, the block still renders: only its clicks stop working.

# block_bin <name> -- print the path of a dwm-* control script.
#
# PATH first, so a user override wins; then the install location. A block is
# spawned by dwmblocks, whose PATH comes from the X session and may not carry
# ~/.config/dwm/bin at all. Returns 1 (prints nothing) when neither has it.
block_bin() {
	command -v "$1" 2>/dev/null && return 0
	_bin="${XDG_CONFIG_HOME:-$HOME/.config}/dwm/bin/$1"
	[ -x "$_bin" ] || return 1
	printf '%s\n' "$_bin"
}

# block_term <tool> <command...> -- run a command in a terminal that dwm floats.
#
# The class is dots-float-<tool>; suckless/dwm/config.def.h floats every class
# containing "dots-float-" with ONE rule (rules[] match by strstr), so a new
# pop-up needs no rebuild. alacritty spells the flag --class, st spells it -c.
# Backgrounded with its output detached: dwmblocks reads the block's stdout,
# and a terminal still holding it open would stall the bar.
# Returns 1 when neither terminal is installed.
block_term() {
	_class="dots-float-$1"
	shift
	if command -v alacritty >/dev/null 2>&1; then
		alacritty --class "$_class" -e "$@" >/dev/null 2>&1 &
	elif command -v st >/dev/null 2>&1; then
		st -c "$_class" -e "$@" >/dev/null 2>&1 &
	else
		return 1
	fi
}

# block_osd volume|mic|brightness -- the same pop-up the media keys show
# (config/sxhkd/sxhkdrc), so a click or scroll on the bar looks like the key.
# Backgrounded for the same reason as block_term. A missing dwm-osd is silent:
# the bar itself already shows the new value.
block_osd() {
	_osd=$(block_bin dwm-osd) || return 0
	"$_osd" "$1" >/dev/null 2>&1 &
}
