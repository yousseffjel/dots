#!/bin/sh
# Screen gamma level, read back from dwm-brightness.
#
# THE NAME IS NOT AN ACCIDENT. Block scripts install to ~/.local/bin, and
# config/zsh/.zshenv puts that ahead of ~/.config/dwm/bin on PATH -- so a
# block named `dwm-brightness` would shadow the control script it calls, and
# sxhkd's `dwm-brightness up` would start invoking this status block instead.
# Do not rename it to match the other blocks.
#
# THE LABEL IS NOT AN ACCIDENT EITHER. This is xrandr gamma, not a backlight
# (roster Epic locked decision 12): the panel keeps drawing full power and only
# the output signal is scaled. A "BRI" or "BL" label would promise the power
# saving that every laptop applet implies and this cannot deliver, so the block
# says GAMMA and means it.
#
# Interval 0 -- signal-driven only, never polled. sxhkd fires
# `pkill -RTMIN+6 dwmblocks` after each change. dwmblocks still renders it once
# at startup via getallcmds(), so the bar is populated before the first change.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT1:=^c#5294e2^}"
: "${STATUS_RESET:=^d^}"

# Prefer PATH so a user override wins, then the known install location. Not
# the other way round: this block is spawned by dwmblocks, whose PATH comes
# from the X session and may not carry ~/.config/dwm/bin at all.
bright=$(command -v dwm-brightness 2>/dev/null)
[ -n "$bright" ] || bright="${XDG_CONFIG_HOME:-$HOME/.config}/dwm/bin/dwm-brightness"

if [ ! -x "$bright" ]; then
	printf '%sGAMMA%s n/a\n' "$STATUS_ACCENT1" "$STATUS_RESET"
	exit 0
fi

pct=$("$bright" get 2>/dev/null)

# dwm-brightness prints nothing and exits non-zero when xrandr has no display
# to talk to. Guard the value rather than printing a bare percent sign.
case "$pct" in
'' | *[!0-9]*)
	printf '%sGAMMA%s n/a\n' "$STATUS_ACCENT1" "$STATUS_RESET"
	exit 0
	;;
esac

printf '%sGAMMA%s %d%%\n' "$STATUS_ACCENT1" "$STATUS_RESET" "$pct"
