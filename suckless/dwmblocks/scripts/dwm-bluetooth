#!/bin/sh
# Bluetooth adapter state and connected-device count, via bluetoothctl.
#
# Every bluetoothctl call is wrapped in `timeout`: it talks to bluetoothd over
# D-Bus, and with the daemon stopped or wedged the call can block. dwmblocks
# runs blocks synchronously, so a hang here freezes the whole bar.
#
# Left-click opens blueman-manager.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT4:=^c#5294e2^}"
: "${STATUS_MUTED:=^c#888888^}"
: "${STATUS_RESET:=^d^}"

BT_TIMEOUT=3

case "$BUTTON" in
1)
	if command -v blueman-manager >/dev/null 2>&1; then
		blueman-manager >/dev/null 2>&1 &
	fi
	;;
esac

if ! command -v bluetoothctl >/dev/null 2>&1; then
	printf '%sBT%s n/a\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
fi

show=$(timeout "$BT_TIMEOUT" bluetoothctl show 2>/dev/null)

# No adapter at all reads the same as a stopped daemon from here, and both
# mean the same thing to the user: there is no bluetooth to show.
if [ -z "$show" ]; then
	printf '%sBT%s n/a\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
fi

case "$show" in
*'Powered: yes'*) ;;
*)
	printf '%sBT%s off\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
	;;
esac

# `devices Connected` is a bluez 5.65+ filter. On an older bluez it errors and
# prints nothing, which counts as zero connected -- the adapter still reports
# as on, so the block degrades to less detail rather than to a wrong state.
n=$(timeout "$BT_TIMEOUT" bluetoothctl devices Connected 2>/dev/null \
	| grep -c '^Device ')

case "$n" in
'' | *[!0-9]*) n=0 ;;
esac

if [ "$n" -gt 0 ]; then
	printf '%sBT%s %d\n' "$STATUS_ACCENT4" "$STATUS_RESET" "$n"
else
	printf '%sBT%s on\n' "$STATUS_ACCENT4" "$STATUS_RESET"
fi
