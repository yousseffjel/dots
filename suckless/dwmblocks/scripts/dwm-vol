#!/bin/sh
# Output volume, via pamixer.
#
# Interval 0 -- signal-driven only, never polled, which is what keeps it off
# the CPU (roster Epic locked decision 9). sxhkd fires
# `pkill -RTMIN+8 dwmblocks` after every volume key. dwmblocks still renders it
# once at startup via getallcmds(), so the bar is populated before the first
# change.
#
# Clicks: left toggles mute, right opens pavucontrol, scroll adjusts by 5%.
# Left and scroll also show the dwm-osd pop-up, exactly as the volume keys do.
# Every mutation happens BEFORE the value is read below, so a single run both
# applies the change and prints the result -- the click is itself the signal
# that re-ran this script, so there is no second refresh to wait for.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT2:=^c#7ebd6f^}"
: "${STATUS_MUTED:=^c#888888^}"
: "${STATUS_RESET:=^d^}"

STEP=5
# Where the speaker icon gains its second and third wave, in percent.
WAVES_2=34
WAVES_3=67

# Shared click helpers (block_bin, block_term, block_osd) -- see dwm-blockutil.
util="${0%/*}/dwm-blockutil"
[ -r "$util" ] || util="$HOME/.local/bin/dwm-blockutil"
[ -r "$util" ] && . "$util"

if ! command -v pamixer >/dev/null 2>&1; then
	printf '%s󰕾%s n/a\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
fi

# Raising unmutes, matching what a hardware volume key does everywhere else.
# Lowering deliberately does not -- turning a muted system down should not
# make it audible. Same rule as config/sxhkd/sxhkdrc's volume bindings.
case "$BUTTON" in
1)
	pamixer --toggle-mute >/dev/null 2>&1
	block_osd volume
	;;
3)
	if command -v pavucontrol >/dev/null 2>&1; then
		pavucontrol >/dev/null 2>&1 &
	fi
	;;
4)
	pamixer --unmute --increase "$STEP" >/dev/null 2>&1
	block_osd volume
	;;
5)
	pamixer --decrease "$STEP" >/dev/null 2>&1
	block_osd volume
	;;
esac

if [ "$(pamixer --get-mute 2>/dev/null)" = "true" ]; then
	printf '%s󰝟%s\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
fi

vol=$(pamixer --get-volume 2>/dev/null)

# pamixer prints nothing when PulseAudio/PipeWire is not reachable. Without
# this guard the block would render a bare percent sign and look like 0.
case "$vol" in
'' | *[!0-9]*)
	printf '%s󰕾%s n/a\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
	;;
esac

# The speaker's waves follow the level: one below a third, three from two
# thirds up. Muted is the crossed speaker alone, with no number.
if [ "$vol" -ge "$WAVES_3" ]; then
	icon=󰕾
elif [ "$vol" -ge "$WAVES_2" ]; then
	icon=󰖀
else
	icon=󰕿
fi

printf '%s%s%s %d%%\n' "$STATUS_ACCENT2" "$icon" "$STATUS_RESET" "$vol"
