#!/bin/sh
# Network state as an icon: Wi-Fi bars and the signal percent, 󰈀 for a wired
# link, 󰤮 when nothing is connected. Read from NetworkManager via nmcli;
# without nmcli (or with NetworkManager stopped) it falls back to the kernel's
# link state, which knows a link is up but not what kind, so it shows 󰛳.
# The SSID is not shown (user decision 2026-10-22, to keep the bar compact);
# a left-click's nmtui names it.
#
# Every nmcli call is wrapped in `timeout`: like bluetoothctl it talks to a
# daemon over D-Bus, and dwmblocks runs blocks synchronously, so a wedged
# NetworkManager would otherwise freeze the whole bar.
#
# The Wi-Fi signal is read with `--rescan no`. A plain `nmcli device wifi`
# may trigger a scan, which takes seconds and would run every 30 s here.
#
# Left-click opens nmtui in a terminal that dwm floats (block_term), else
# nm-connection-editor, else a notification naming the missing package.
#
# DWM_NET_SYSFS overrides /sys/class/net, for tests/dwm-net.sh only.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT4:=^c#5294e2^}"
: "${STATUS_MUTED:=^c#888888^}"
: "${STATUS_RESET:=^d^}"

# Shared click helpers (block_bin, block_term, block_osd) -- see dwm-blockutil.
util="${0%/*}/dwm-blockutil"
[ -r "$util" ] || util="$HOME/.local/bin/dwm-blockutil"
[ -r "$util" ] && . "$util"

NM_TIMEOUT=3
sysfs="${DWM_NET_SYSFS:-/sys/class/net}"

case "$BUTTON" in
1)
	# nmtui ships inside Void's NetworkManager package (Fedora split it out
	# as NetworkManager-tui). Without it fall back to nm-connection-editor,
	# which dwm's rules[] floats; with neither, say so rather than leave the
	# click silently dead.
	if command -v nmtui >/dev/null 2>&1; then
		block_term nmtui nmtui
	elif command -v nm-connection-editor >/dev/null 2>&1; then
		nm-connection-editor >/dev/null 2>&1 &
	elif command -v notify-send >/dev/null 2>&1; then
		notify-send -u low "Network" "No network tool: install NetworkManager (nmtui)"
	fi
	;;
esac

on() { printf '%s%s%s%s\n' "$STATUS_ACCENT4" "$1" "$STATUS_RESET" "${2:+ $2}"; }
off() { printf '%s󰤮%s\n' "$STATUS_MUTED" "$STATUS_RESET"; }

# wifi_icon <signal> -- the bars for a 0-100 signal, one per 20 points over 20.
wifi_icon() {
	if [ "$1" -ge 80 ]; then
		echo 󰤨
	elif [ "$1" -ge 60 ]; then
		echo 󰤥
	elif [ "$1" -ge 40 ]; then
		echo 󰤢
	elif [ "$1" -ge 20 ]; then
		echo 󰤟
	else
		echo 󰤯
	fi
}

# Kernel view: any interface other than loopback whose operstate is up.
sysfs_state() {
	for dev in "$sysfs"/*; do
		[ "${dev##*/}" = lo ] && continue
		[ "$(cat "$dev/operstate" 2>/dev/null)" = up ] && {
			on 󰛳
			return
		}
	done
	off
}

status=""
if command -v nmcli >/dev/null 2>&1; then
	status=$(timeout "$NM_TIMEOUT" nmcli -t -f TYPE,STATE,CONNECTION device status 2>/dev/null)
fi
if [ -z "$status" ]; then
	sysfs_state
	exit 0
fi

# Terse mode separates fields with ':' and escapes a ':' inside a field as
# '\:'. TYPE and STATE never contain one, and they come first, so the
# connection name (which can) is never split on. Wi-Fi wins over wired when
# both are up, since its signal is the more useful thing to show.
wired=""
wifi=""
while IFS= read -r line; do
	type=${line%%:*}
	rest=${line#*:}
	state=${rest%%:*}
	# "connected (externally)" is a link NetworkManager sees but did not set
	# up (a static config, a VM's network); it is still a connection.
	# Loopback reports that state too, and is excluded by its type below.
	case "$state" in
	connected*) ;;
	*) continue ;;
	esac
	case "$type" in
	wifi) wifi=1 ;;
	ethernet) wired=1 ;;
	esac
done <<EOF
$status
EOF

if [ -n "$wifi" ]; then
	signal=$(timeout "$NM_TIMEOUT" nmcli -t -f ACTIVE,SIGNAL device wifi list --rescan no 2>/dev/null \
		| sed -n 's/^yes:\([0-9]*\)$/\1/p' | head -n 1)
	if [ -n "$signal" ]; then
		on "$(wifi_icon "$signal")" "$signal%"
	else
		on 󰖩
	fi
elif [ -n "$wired" ]; then
	on 󰈀
else
	off
fi
