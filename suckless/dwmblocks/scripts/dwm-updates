#!/bin/sh
# Pending package updates, counted from dnf's LOCAL metadata only.
#
# `-C` is load-bearing, not an optimisation. Without it dnf hits the network,
# which can take seconds, and dwmblocks runs each block synchronously -- one
# slow block stalls the entire bar. The cache this reads is refreshed
# out-of-band by Fedora's own dnf-makecache.timer, so the count is exactly as
# fresh as that timer and never fresher. `timeout` is the second guard: a
# wedged rpmdb lock would otherwise hang the bar indefinitely.
#
# Left-click lists the packages via notify-send, reusing the output already
# captured rather than paying for a second dnf run. Right-click runs the
# upgrade in a terminal dwm floats (dwm-blockutil's block_term).

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT2:=^c#7ebd6f^}"
: "${STATUS_WARN:=^c#d9a05b^}"
: "${STATUS_RESET:=^d^}"

# Generous, because this only has to catch a wedged rpmdb lock -- a healthy
# cache-only run is well under a second.
DNF_TIMEOUT=20

# The right-click upgrade, run by sh inside the terminal. sudo needs a TTY to
# prompt, which is why this is a terminal and not a background job. The
# signal (this block's, 1 in blocks.def.h) is sent the moment dnf finishes, so
# the count drops while the window is still open; the terminal then waits for
# Enter, or a failed upgrade would vanish before it could be read.
UPGRADE_CMD='sudo dnf upgrade --refresh; rc=$?; pkill -RTMIN+1 dwmblocks; printf "\n[dnf exited %s] Press Enter to close. " "$rc"; read -r _'

# Shared click helpers (block_bin, block_term, block_osd) -- see dwm-blockutil.
util="${0%/*}/dwm-blockutil"
[ -r "$util" ] || util="$HOME/.local/bin/dwm-blockutil"
[ -r "$util" ] && . "$util"

if ! command -v dnf >/dev/null 2>&1; then
	printf '%sUPD%s n/a\n' "$STATUS_ACCENT2" "$STATUS_RESET"
	exit 0
fi

# Right-click goes first: it must work even when the count below cannot be
# read -- no cache yet is exactly when an upgrade with --refresh helps.
case "$BUTTON" in
3) block_term updates sh -c "$UPGRADE_CMD" ;;
esac

# dnf exits 100 when updates exist and 0 when none do. Both are success here;
# anything else (no cache yet, rpmdb locked, timeout) is not.
out=$(timeout "$DNF_TIMEOUT" dnf -C check-update -q 2>/dev/null)
rc=$?
if [ "$rc" -ne 0 ] && [ "$rc" -ne 100 ]; then
	printf '%sUPD%s n/a\n' "$STATUS_ACCENT2" "$STATUS_RESET"
	exit 0
fi

# Package lines are `name.arch  version  repo` -- three fields. Anything
# else is a header: dnf5 opens with a bare "Upgrades" line. The "Obsoleting
# Packages" section that can follow has the package shape, so stop at its
# header using a flag rather than awk's exit, which would SIGPIPE the
# producer. Both the count and the left-click list come from this one filter,
# so the list cannot show a line the count skipped.
pkgs=$(printf '%s\n' "$out" | awk '
	/^Obsoleting Packages/ { done = 1 }
	!done && NF == 3
')
n=$(printf '%s' "$pkgs" | awk 'END { print NR }')

# A neglected box can have hundreds pending, and dunst will happily render a
# notification taller than the screen. Cap the body and say what was cut.
NOTIFY_LINES=20

case "$BUTTON" in
1)
	if command -v notify-send >/dev/null 2>&1; then
		body=$(printf '%s\n' "$pkgs" | head -n "$NOTIFY_LINES")
		if [ "$n" -gt "$NOTIFY_LINES" ]; then
			body="$body
... and $((n - NOTIFY_LINES)) more"
		fi
		notify-send -u low "$n update(s) pending" "$body"
	fi
	;;
esac

if [ "$n" -gt 0 ]; then
	printf '%sUPD%s %d\n' "$STATUS_WARN" "$STATUS_RESET" "$n"
else
	printf '%sUPD%s 0\n' "$STATUS_ACCENT2" "$STATUS_RESET"
fi
