#!/bin/sh
# Pending package updates, counted from xbps's LOCAL repo index only.
#
# `xbps-install -nu` is a dry run of a full upgrade against the index already
# on disk: no root, no network (no -S). That matters because dwmblocks runs
# each block synchronously -- one slow block stalls the entire bar. The flip
# side: the count is exactly as fresh as the last sync (any `xbps-install -S`,
# which every installer run and `dots update` do; Void has no sync timer).
# `timeout` is the second guard, against a wedged pkgdb lock.
#
# The output, probed with xbps 0.60.7 (2026-10-15), is one line per package:
#   oniguruma-6.9.10_1 update x86_64 https://repo-default.voidlinux.org/current 640404 199767
# `update` lines are the pending updates; `install` lines are new
# dependencies an update would pull in, not updates. Exit 0 either way.
#
# Left-click lists the packages via notify-send, reusing the output already
# captured rather than paying for a second xbps run. Right-click runs the
# upgrade in a terminal dwm floats (dwm-blockutil's block_term).

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT2:=^c#7ebd6f^}"
: "${STATUS_WARN:=^c#d9a05b^}"
: "${STATUS_RESET:=^d^}"

# Generous, because this only has to catch a wedged pkgdb lock -- a healthy
# local dry run is well under a second.
XBPS_TIMEOUT=20

# The right-click upgrade, run by sh inside the terminal. sudo needs a TTY to
# prompt, which is why this is a terminal and not a background job. -Su: a
# sync and a FULL upgrade, the only kind Void supports. The signal (this
# block's, 1 in blocks.def.h) is sent the moment xbps finishes, so the count
# drops while the window is still open; the terminal then waits for Enter, or
# a failed upgrade would vanish before it could be read.
UPGRADE_CMD='sudo xbps-install -Su; rc=$?; pkill -RTMIN+1 dwmblocks; printf "\n[xbps exited %s] Press Enter to close. " "$rc"; read -r _'

# Shared click helpers (block_bin, block_term, block_osd) -- see dwm-blockutil.
util="${0%/*}/dwm-blockutil"
[ -r "$util" ] || util="$HOME/.local/bin/dwm-blockutil"
[ -r "$util" ] && . "$util"

if ! command -v xbps-install >/dev/null 2>&1; then
	printf '%s󰏗%s n/a\n' "$STATUS_ACCENT2" "$STATUS_RESET"
	exit 0
fi

# Right-click goes first: it must work even when the count below cannot be
# read -- no synced index yet is exactly when an upgrade with -S helps.
case "$BUTTON" in
3) block_term updates sh -c "$UPGRADE_CMD" ;;
esac

# Anything but exit 0 (no index yet, pkgdb locked, timeout, "the xbps package
# must be updated") is not a count.
out=$(timeout "$XBPS_TIMEOUT" xbps-install -nu 2>/dev/null)
rc=$?
if [ "$rc" -ne 0 ]; then
	printf '%s󰏗%s n/a\n' "$STATUS_ACCENT2" "$STATUS_RESET"
	exit 0
fi

# The new pkgver of each `update` line. Both the count and the left-click
# list come from this one filter, so the list cannot show a line the count
# skipped.
pkgs=$(printf '%s\n' "$out" | awk '$2 == "update" { print $1 }')
n=$(printf '%s' "$pkgs" | awk 'END { print NR }')

# A neglected box can have hundreds pending, and dunst will happily render a
# notification taller than the screen. Cap the body and say what was cut.
NOTIFY_LINES=20

case "$BUTTON" in
1)
	if command -v notify-send >/dev/null 2>&1; then
		body=$(printf '%s\n' "$pkgs" | head -n "$NOTIFY_LINES")
		if [ "$n" -gt "$NOTIFY_LINES" ]; then
			body="$body
... and $((n - NOTIFY_LINES)) more"
		fi
		notify-send -u low "$n update(s) pending" "$body"
	fi
	;;
esac

if [ "$n" -gt 0 ]; then
	printf '%s󰏗%s %d\n' "$STATUS_WARN" "$STATUS_RESET" "$n"
else
	printf '%s󰏗%s 0\n' "$STATUS_ACCENT2" "$STATUS_RESET"
fi
