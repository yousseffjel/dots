#!/bin/sh
# Microphone state, via pamixer's default SOURCE (not the sink dwm-vol reads).
#
# Interval 0 -- signal-driven only, never polled. sxhkd fires
# `pkill -RTMIN+7 dwmblocks` after XF86AudioMicMute. dwmblocks still renders it
# once at startup via getallcmds().
#
# Left-click toggles mute. The mutation happens before the read below, so one
# run both applies the change and prints the result.
#
# Every pamixer call here carries --default-source. Dropping it from even one
# of them silently reads or writes the speakers instead, which is the kind of
# bug that looks fine until you mute the wrong device on a call.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT3:=^c#5294e2^}"
: "${STATUS_MUTED:=^c#888888^}"
: "${STATUS_RESET:=^d^}"

if ! command -v pamixer >/dev/null 2>&1; then
	printf '%sMIC%s n/a\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
fi

case "$BUTTON" in
1) pamixer --default-source --toggle-mute >/dev/null 2>&1 ;;
esac

if [ "$(pamixer --default-source --get-mute 2>/dev/null)" = "true" ]; then
	printf '%sMIC%s off\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
fi

vol=$(pamixer --default-source --get-volume 2>/dev/null)

case "$vol" in
'' | *[!0-9]*)
	printf '%sMIC%s n/a\n' "$STATUS_MUTED" "$STATUS_RESET"
	exit 0
	;;
esac

printf '%sMIC%s %d%%\n' "$STATUS_ACCENT3" "$STATUS_RESET" "$vol"
