#!/bin/sh
# Wall clock. Left-click toggles the month calendar (dwm-calendar, a GTK
# popup under the clock); without it, the month comes as a notification
# instead. The block degrades to plain output if neither is there.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${COL_CLOCK:=#d9a05b}"

# Shared click helpers (block_bin) -- see dwm-blockutil.
util="${0%/*}/dwm-blockutil"
[ -r "$util" ] || util="$HOME/.local/bin/dwm-blockutil"
[ -r "$util" ] && . "$util"

case "$BUTTON" in
1)
	# Backgrounded with its output detached: dwmblocks reads this block's
	# stdout, and a window still holding it open would stall the bar. A
	# second click reaches the open calendar and closes it.
	if command -v block_bin >/dev/null 2>&1 && calendar=$(block_bin dwm-calendar) \
		&& python3 -c 'import gi; gi.require_version("Gtk", "3.0")' >/dev/null 2>&1; then
		"$calendar" >/dev/null 2>&1 &
	elif command -v notify-send >/dev/null 2>&1; then
		notify-send -u low "$(date '+%B %Y')" "$(cal)"
	fi
	;;
esac

# One date(1) call, not two: this runs every 60s for the life of the session,
# and the two calls could also straddle a minute boundary and disagree.
date "+^c${COL_CLOCK}^%a %d %b^d^ %H:%M"
