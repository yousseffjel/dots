#!/bin/sh
# CPU package temperature, straight from /sys/class/hwmon.
#
# Read from sysfs rather than shelling out to `sensors`, so this needs no
# lm_sensors package and costs a couple of virtual-file reads. That matters:
# this is the fastest block in the bar at a 5s interval.
#
# Sensors are matched BY NAME, never by hwmon number -- the numbering is
# assigned in probe order and changes between boots, so hwmon0 is not a stable
# handle for anything. Only CPU-package drivers are accepted; a machine whose
# CPU sensor is named something else reports n/a rather than silently showing
# the motherboard or an NVMe drive, which is the failure you would never catch
# by looking. Adding a name to CPU_SENSORS below is the whole fix.

# Shared palette, with a fallback so the block still renders if it is missing.
# Prefer the wallpaper-themed palette generated by the theming engine
# (scripts/theme/apply-templates.sh); fall back to the static one shipped
# alongside this script so an un-themed install still renders correctly.
colors="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/statusbar-colors.sh"
[ -r "$colors" ] || colors="${0%/*}/dwm-colors"
[ -r "$colors" ] || colors="$HOME/.local/bin/dwm-colors"
[ -r "$colors" ] && . "$colors"
: "${STATUS_ACCENT3:=^c#5294e2^}"
: "${STATUS_WARN:=^c#d9a05b^}"
: "${STATUS_URGENT:=^c#cc5555^}"
: "${STATUS_RESET:=^d^}"

# coretemp = Intel, k10temp = AMD, zenpower = AMD third-party module,
# cpu_thermal = ARM SoCs.
CPU_SENSORS='coretemp k10temp zenpower cpu_thermal'
WARN_C=70
URGENT_C=80

# Allow the sysfs root to be redirected so this is testable against a
# synthetic tree; defaults to the real one.
HWMON_ROOT="${DOTS_HWMON_ROOT:-/sys/class/hwmon}"

milli=
for hw in "$HWMON_ROOT"/hwmon*; do
	[ -r "$hw/name" ] || continue
	[ -r "$hw/temp1_input" ] || continue

	name=$(cat "$hw/name" 2>/dev/null)
	match=0
	for want in $CPU_SENSORS; do
		[ "$name" = "$want" ] && match=1 && break
	done
	[ "$match" -eq 1 ] || continue

	milli=$(cat "$hw/temp1_input" 2>/dev/null)
	break
done

# No recognised sensor, or one that read back as something other than a
# number. Either way there is no temperature to report.
case "$milli" in
'' | *[!0-9]*)
	printf '%sTEMP%s n/a\n' "$STATUS_ACCENT3" "$STATUS_RESET"
	exit 0
	;;
esac

# hwmon reports millidegrees Celsius. Round rather than truncate.
deg=$(((milli + 500) / 1000))

if [ "$deg" -ge "$URGENT_C" ]; then
	col=$STATUS_URGENT
elif [ "$deg" -ge "$WARN_C" ]; then
	col=$STATUS_WARN
else
	col=$STATUS_ACCENT3
fi

printf '%sTEMP%s %d°C\n' "$col" "$STATUS_RESET" "$deg"
