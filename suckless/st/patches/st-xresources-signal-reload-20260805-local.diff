+/* xresources patch (signal-reload variant) — st.background, st.foreground,
+ * st.color0..st.color255, st.cursorColor. Reload path: killall -USR1 st
+ * re-reads these into a running terminal without restarting it. */
+#define XRESOURCE_LOAD_META(NAME)                                        \
+	if (!XrmGetResource(xrdb, "st." NAME, "st." NAME, &type, &ret))  \
+		XrmGetResource(xrdb, "*." NAME, "*." NAME, &type, &ret); \
+	if (ret.addr != NULL && !strncmp("String", type, 64))
+
+#define XRESOURCE_LOAD_STRING(NAME, DST) \
+	XRESOURCE_LOAD_META(NAME)        \
+		DST = ret.addr;
+
+void
+xrdb_load(void)
+{
+	char *xrm, *type;
+	XrmDatabase xrdb;
+	XrmValue ret;
+	Display *dpy;
+	char loadvalue[16];
+	int i;
+
+	if (!(dpy = XOpenDisplay(NULL)))
+		return;
+
+	XrmInitialize();
+	xrm = XResourceManagerString(dpy);
+	if (xrm != NULL) {
+		xrdb = XrmGetStringDatabase(xrm);
+
+		for (i = 0; i < 256; i++) {
+			snprintf(loadvalue, sizeof(loadvalue), "st.color%d", i);
+			if (!XrmGetResource(xrdb, loadvalue, loadvalue, &type, &ret)) {
+				snprintf(loadvalue, sizeof(loadvalue), "*.color%d", i);
+				XrmGetResource(xrdb, loadvalue, loadvalue, &type, &ret);
+			}
+			if (ret.addr != NULL && !strncmp("String", type, 64))
+				colorname[i] = ret.addr;
+		}
+
+		XRESOURCE_LOAD_STRING("foreground", colorname[defaultfg]);
+		XRESOURCE_LOAD_STRING("background", colorname[defaultbg]);
+		XRESOURCE_LOAD_STRING("cursorColor", colorname[defaultcs]);
+
+		/* Deliberately not destroyed: colorname[] now holds pointers
+		 * into strings owned by this database (XrmGetResource hands
+		 * back pointers into the db, not copies). Destroying it here
+		 * would free memory colorname[] still points to, and
+		 * xloadcols() dereferences those pointers right after this
+		 * function returns (and again on every future reload). The
+		 * previous db from an earlier reload is abandoned the same
+		 * way when this runs again — a small intentional per-reload
+		 * leak, not a correctness bug; matches upstream's own
+		 * xrdb_load(), which never frees it either. */
+	}
+	XCloseDisplay(dpy);
+}
+
+void
+reload(int sig)
+{
+	xrdb_load();
+	xloadcols();
+	redraw();
+
+	signal(SIGUSR1, reload);
+}
+
 void
