#!/bin/sh

cachedir="${XDG_CACHE_HOME:-"$HOME/.cache"}"
cache="$cachedir/dmenu_run"
# pathcache-local patch: the PATH the cache was built for. stest -n alone only
# notices a directory NEWER than the cache, so one that joins PATH later (and
# is older than the cache) would never be scanned.
pathfile="$cache.path"

[ ! -e "$cachedir" ] && mkdir -p "$cachedir"

IFS=:
if stest -dqr -n "$cache" $PATH || [ "$(cat "$pathfile" 2>/dev/null)" != "$PATH" ]; then
	stest -flx $PATH | sort -u | tee "$cache"
	printf '%s\n' "$PATH" >"$pathfile"
else
	cat "$cache"
fi
