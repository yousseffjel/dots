# Best-effort packages — install-fedora.sh installs these one at a time; a
# single missing/renamed package is skipped with a warning instead of
# aborting the run. See packages/core.lst for the small required subset this
# installer hard-depends on.
#
# Format: one package name per line. '#' starts a comment (whole-line or
# trailing). Blank lines ignored.
#
# NOT LISTED HERE, deliberately:
#
#   starship — not in Fedora's repos at all (dropped around F37; verified
#     2026-08-06, zero results across F43/44/Rawhide/EPEL). It is the prompt
#     (config/zsh/conf.d/99-prompt.zsh + config/starship/starship.toml), so
#     install-pkg.sh installs it from the upstream script instead. The COPR
#     alternative, if you prefer dnf to own it:
#       dnf copr enable atim/starship && dnf install starship
#
#   JetBrains Mono Nerd Font — Fedora packages no such variant. The
#     jetbrains-mono-fonts source produces only -all and -nl, neither with
#     nerd glyphs; cascadia-code-nf-fonts below is the glyph font.
#
#   ddcutil / i2c-dev — brightness is xrandr gamma on this desktop target,
#     not DDC/CI. See the roster Epic's locked decision 10.
#
#   brightnessctl — same reason, and it was listed here by mistake until
#     2026-08-07. It drives /sys/class/backlight, which a desktop GPU does
#     not expose, so it could never have worked on this target. Brightness
#     is config/dwm/bin/dwm-brightness (xrandr gamma), locked decision 12.
#     On a laptop target, `dnf install brightnessctl` and teach that script
#     to prefer it.
#
#   power-profiles-daemon — desktop, not laptop. Locked decision 9.
#
#   unrar — RPM Fusion nonfree. `unar` below extracts RAR from the official
#     repos, so no third-party repo is needed. Locked decision 8.

# core system & display server
xorg-x11-server-Xorg
xorg-x11-xinit
xrandr
xsetroot
xset
xrdb
xinput
libX11-devel
libXft-devel
libXinerama-devel
freetype-devel
fontconfig-devel
NetworkManager
network-manager-applet
dnf-plugins-core
pipewire
pipewire-pulseaudio
pipewire-alsa
pipewire-jack-audio-connection-kit
wireplumber
polkit-gnome
opendoas
fuse

# interface foundation
# sxhkd owns every keybind except dwm's own window management, which stays
# compiled into suckless/dwm/config.def.h (roster Epic sub-task 4).
sxhkd
# alacritty is the terminal (dwm's termcmd, thunar's, and the statusbar click
# actions'). st stays vendored and built as the no-GPU fallback.
alacritty

# applications
firefox

# fonts & theming
# cascadia-code-nf-fonts is the Nerd Font: Cascadia Code is what the Nerd
# Fonts project ships as "CaskaydiaCove", and it is the only -nf-fonts family
# Fedora packages. It supplies every glyph the prompt (starship), the eza
# --icons aliases and fastfetch rely on — without it those render as tofu.
# jetbrains-mono-fonts-all stays for plain UI surfaces, which need no glyphs.
cascadia-code-nf-fonts
jetbrains-mono-fonts-all
google-noto-emoji-fonts
google-noto-sans-fonts
papirus-icon-theme
adwaita-icon-theme
# ImageMagick drives the theming engine's colour extraction
# (scripts/theme/colorgen.sh) — without it wallpaper.sh/theme-apply.sh
# cannot generate a palette.
#
# Deliberately NOT listed: gtk-murrine-engine. It is a GTK2-only engine,
# and themes/dark/theme.conf selects Adwaita-dark — a GTK3 built-in that
# never loads it. Add it only alongside an actual Murrine-based GTK2 theme.
ImageMagick

# desktop utilities, clipboard & file management
picom
dunst
libnotify
feh
xclip
xsel
# maim + slop back config/dwm/bin/dwm-screenshot (roster Epic sub-task 5):
# maim captures, slop draws the region selector, xclip puts it on the clipboard.
#
# xprop is there for the active-window mode alone. It reads the window id out
# of the root window's _NET_ACTIVE_WINDOW property, which maim then takes
# verbatim — maim parses the 0x-prefixed form xprop prints. xdotool would do
# the same job in one call with no parsing, but it drags in a whole
# input-simulation stack (libxdo) that nothing else in this roster wants.
# Missing xprop degrades to a diagnostic on the window mode only; full-screen
# and region capture keep working.
maim
slop
xprop
# xss-lock bridges X's screensaver timer and systemd-logind, so slock also
# fires on suspend — which xautolock structurally cannot do (sub-task 6).
xss-lock
# bluetooth: bluez is the stack, blueman the GTK manager the statusbar
# block's click action opens (sub-task 7).
bluez
blueman
# playerctl drives the XF86Audio{Play,Next,Prev,Stop} keys over MPRIS and
# pamixer the volume/mic keys — both bound in config/sxhkd/sxhkdrc, which
# also signals the matching dwmblocks blocks.
playerctl
pamixer
pavucontrol
alsa-utils
# file manager (roster Epic sub-task 8). thunar-archive-plugin + file-roller
# handle archives (unar covers RAR from Fedora proper — locked decision 8,
# unrar is RPM Fusion nonfree); thunar-volman + gvfs auto-mount removable
# media; tumbler + ffmpegthumbnailer produce video/PDF thumbnails; catfish
# is the search front end.
thunar
thunar-archive-plugin
thunar-volman
tumbler
ffmpegthumbnailer
file-roller
unar
catfish
gvfs
# xfce4-settings is here for ONE binary: /usr/bin/xfce4-mime-helper. Thunar
# hardcodes `exo-open --launch TerminalEmulator` for its built-in "Open
# Terminal Here", and exo 4.15.1 moved the helper framework out of exo
# ("Removed binaries: exo-compose-mail, exo-helper-2") into this package,
# which also ships the /usr/share/xfce4/helpers/ definitions that
# config/xfce4/helpers.rc names — alacritty.desktop among them. Without it
# helpers.rc is inert and that menu entry falls back to xfce4-terminal,
# which this roster does not install. Nothing starts xfsettingsd; the rest
# of the package is inert on a dwm session.
xfce4-settings
lxappearance
xdg-user-dirs
unzip
p7zip
p7zip-plugins
zip
tar

# development stack (Node.js is handled by nvm, not dnf — see install-fedora.sh header)
neovim
vim
tmux
rust
cargo
python3-pip
fzf
bat
eza
zoxide
fastfetch
htop
tree
pv
jq
figlet
trash-cli
ripgrep
fd-find
curl
wget
binutils
coreutils

# display manager
ly
