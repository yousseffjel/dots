# chassis: laptop
#
# Laptop-only packages. The line above is load-bearing: pkg_list_chassis
# (scripts/install-pkg-tiers.sh) reads it, so `dots doctor` checks this list
# only on a machine drivers_chassis calls a laptop, and never warns about it
# on a desktop. install-pkg.sh does NOT read this file. scripts/drivers-lib.sh
# installs it, and only on a laptop: during the installer's package stage and
# from `dots drivers`. Same arrangement as build.lst and install-suckless.sh.
#
# Best-effort, like extra.lst: a failure is one yellow line, never an abort.
# Every package installed from here gets a PACKAGE manifest row, so
# `dots uninstall` removes it again.
#
# A desktop keeps today's behaviour (scope-h, DECISION REVERSAL of scope-b
# decisions 9 and 12): see .claude/tasks/scope-h-laptop-support.md.

# Backlight. dwm-brightness uses it when /sys/class/backlight has a device,
# and falls back to xrandr gamma without it. Void builds it WITHOUT logind
# support (0.5.1_1 depends on glibc only). It writes /sys directly, through
# the udev rule it ships, which grants the `video` group. The Void
# installer's default groups include video; scope I decision D4 covers it.
brightnessctl

# Power profiles (power-saver / balanced / performance), switched by
# config/dwm/bin/dwm-power (Super+Shift+p). power-profiles-daemon serves the
# same D-Bus API dwm-power already speaks (it replaced Fedora's tuned-ppd,
# which Void does not package). Its runit service is enabled by
# scripts/drivers-laptop.sh (scope I, sub-task I-7; until then that script
# still names tuned).
power-profiles-daemon
