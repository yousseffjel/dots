# Desktop-critical packages — install-pkg.sh installs these one at a time and
# NEVER aborts on a failure, but every failure is repeated in a red block at
# the end of the run together with the consequence spelled out below.
#
# THE CRITERION: without this package a shipped keybind, an autostart daemon,
# or the theming engine silently does nothing. Silently is the operative word.
# picom was packaged, configured, themed and performance-tuned for two months
# while nothing launched it, and the installer reported a clean run throughout
# (see .claude/changes/archive/2026-08-08-picom-autostart.md). A package whose absence
# announces itself does not need to be here.
#
# Not the same as core.lst. core.lst hard-fails because the installer's own
# next step breaks; this list keeps going because a degraded desktop you can
# log into and repair beats no desktop at all. That matters more than usual
# here: these names are checked against a snapshot of Void's repo index
# (tests/void-pkgnames.sh), never against a live xbps on the target, so an
# upstream rename must not be able to brick an install.
#
# THE TRAILING COMMENT IS LOAD-BEARING. Everything after '#' on a package
# line is that package's consequence text, and install-pkg.sh reads it back
# out to build the failure summary. read_pkg_list() already strips trailing
# comments, so the install path itself is unaffected and the fact lives in
# exactly one place. tests/desktop-consequences.sh fails the build if any
# entry here lacks one.
#
# Format: one package name per line, then '#' and the consequence. Whole-line
# '#' comments and blank lines are ignored.

# --- the X session itself ---
# xorg-minimal, not xorg-server: the server alone ships no input driver, so
# keyboard and mouse would be dead. The metapackage adds xauth, xinit and
# xf86-input-libinput. Video goes through the server's built-in modesetting
# driver, which needs mesa-dri for glamor and GLX.
xorg-minimal  # no X server, input driver or xauth: the desktop cannot start
xinit  # no startx: ~/.xinitrc is never read, so dwm never execs
mesa-dri  # no GL driver: Xorg falls back to unaccelerated drawing, and picom and video playback crawl
# ly is not packaged on Void. It is built from source by the services stage
# (scope I, decision D1), so it is not a line here.

# --- session plumbing (scope I, decision D2: elogind) ---
dbus  # no D-Bus: dunst, the portal, polkit and NetworkManager all need a bus, and every notification is dropped
elogind  # no session manager: suspend, reboot and poweroff in the power menu fail, and polkit sees no active session, so mounting and network changes are denied
# The Secret Service (scope K, decision 1). Nothing here starts it: ly's
# stock /etc/pam.d/ly already carries `-auth`/`-session optional
# pam_gnome_keyring.so auto_start` (the `-` skips a missing module), so the
# login password unlocks it, and the bus activates the secrets component
# through org.freedesktop.secrets.service on first use.
gnome-keyring  # no Secret Service: browsers, VS Code and git credential helpers keep passwords and tokens in plain text on disk, or ask for a keyring that never comes

# --- X tools the shipped scripts call by name ---
xrdb  # theming engine cannot load colours; dwm, st, dmenu and slock stay at their compiled defaults
xrandr  # the brightness keys do nothing — dwm-brightness drives gamma through it
gammastep  # no night light: Super+n does nothing and the screen never warms at dusk
xset  # dwm-lock cannot arm X's idle timers, so the screen never locks on inactivity
xclip  # screenshots are captured but never reach the clipboard
xdotool  # the Super+c colour picker dies: dwm-colorpicker reads the pointer position with getmouselocation and has no fallback for it; the 'monitor' screenshot and recording modes fail too

# --- keys, and the signalling the status bar depends on ---
sxhkd  # EVERY non-dwm keybind dies at once: media, volume, mic, brightness, screenshot, lock, theming and launchers
procps-ng  # pgrep/pkill missing: the status bar never refreshes after a volume or brightness change, and powermenu logout dies

# --- daemons autostart.sh launches ---
picom  # no compositor: no vsync, and the tuned ~/.config/picom/picom.conf is read by nothing
glxinfo  # autostart.sh cannot probe the GL renderer, so picom always runs on the slower xrender backend, even on a real GPU
dunst  # no notification daemon: every notify-send in the shipped scripts is silently dropped
jq  # the notification centre (Super+Ctrl+n, a left-click on the bell) cannot read dunst's history and never opens
xdg-utils  # links never open: "open" in the notification centre skips them, and dunst's link menu (browser = xdg-open in dunstrc) does nothing
libnotify  # notify-send itself is missing: wallpaper, theme and screenshot feedback all vanish
xss-lock  # the screen never locks on idle or on suspend; only the manual Super+Shift+l keybind still works
xsettingsd  # GTK apps get no XSETTINGS: Xft DPI, antialiasing and hinting fall back to each toolkit's own defaults, and a themes/dark/theme.conf edit needs an app restart instead of a theme reload
udiskie  # USB sticks and SD cards never auto-mount: thunar-volman only does it while Thunar is running, and nothing daemonises Thunar, so removable media has to be mounted by hand
# dwm-xdg-autostart hands each ~/.config/autostart entry to it (scope K).
dex  # apps set to start at login (their own "start at login" switch, which writes ~/.config/autostart) never start
autorandr  # display profiles are never applied: plugging in an external monitor leaves the layout untouched, and the profile saved by autorandr --save is only reachable by running it by hand

# --- theming engine ---
# Qt apps (scope K, decision 2): config/zsh/.zshenv sets
# QT_QPA_PLATFORMTHEME=qt5ct, which each plugin answers (qt5ct-1.9 and
# qt6ct-0.11 accept both keys), and always/qt.dcol renders their colours.
qt5ct  # Qt5 apps (VLC, qBittorrent, KeePassXC) open light and unthemed beside dark GTK apps, and never follow the wallpaper
qt6ct  # Qt6 apps open light and unthemed beside dark GTK apps, and never follow the wallpaper
ImageMagick  # no colour extraction: wallpaper.sh and theme-apply.sh cannot build a palette from the wallpaper
feh  # wallpaper.sh exits early — no wallpaper can be set, so no theme can be generated

# --- terminal and screenshot, both keybound ---
alacritty  # the terminal keybind and thunar's "Open Terminal Here" fall back to the vendored st
maim  # the screenshot keys capture nothing at all
slop  # region and window screenshot modes die; full-screen capture still works
xinput  # Super+a, the region screenshot key, does nothing: dwm-shotkey reads it from xinput's raw key events (Shift+Print still works)
xprop  # the active-window screenshot mode degrades to a diagnostic; full-screen and region are unaffected
# Screen recording (Super+r, dwm-record) and mpv's decoders. Void's ffmpeg6
# is the full build: its configure line (read from libavcodec.so.60, 6.1.6_3,
# 2026-10-15) has --enable-gpl, libx264, libx265 and vaapi and disables no
# decoder, so HEVC/HDR plays with no third-party repo. `ffmpeg` is only a
# transitional dummy that depends on ffmpeg6.
ffmpeg6  # the Super+r screen recorder cannot start

# --- emoji picker, keybound ---
# Data files only (/usr/share/unicode/emoji/emoji-test.txt, the path
# dwm-emoji reads; checked in unicode-emoji-14.0_1). The binary side is xclip.
unicode-emoji  # the Super+; emoji picker has no list to show and exits with a notification

# status-bar clicks (suckless/dwmblocks/scripts)
# nmtui ships inside NetworkManager on Void (checked in 1.56.0_1).
NetworkManager  # no network manager: no Wi-Fi or connection control, and left-click on the NET block opens no nmtui

# --- media and volume keys ---
playerctl  # the XF86Audio play/next/prev/stop keys do nothing
pamixer  # volume and mic keys do nothing, and both status blocks go blank

# --- audio stack those keys drive ---
# Void's pipewire package includes pipewire-pulse (the PulseAudio shim
# pamixer talks to). Nothing starts it without systemd user units: the
# session start-up does that (scope I, sub-task I-6).
pipewire  # no sound server for pamixer to talk to
wireplumber  # pipewire has no session manager, so devices are never linked

# --- fonts ---
# Cascadia Code NF (the Nerd Font glyph face) is not packaged on Void; it is
# vendored under assets/ (scope I, decision D3), so it is not a line here.
#
# One package carries every Noto face fonts.conf names: Noto Sans, Serif,
# Sans Mono, and the Arabic pair it prefers for lang=ar (NotoSansArabic,
# NotoNaskhArabic; checked in 2026.10.01_1). Without it fontconfig picks
# whatever Arabic face happens to be installed, often none on a base system.
noto-fonts-ttf  # Arabic text and the GTK UI font fall back to tofu or a random face in GTK apps, the browser, dmenu and the dwm title

# --- cursor theme ---
# GNU tar's -J filters through the EXTERNAL xz binary rather than linking
# liblzma, so `tar -xJf` fails outright without this package — see
# scripts/install-restore-cursor.sh. Practically always present (it is in
# @core), declared anyway: rule 10 exists because the undeclared dependency is
# the one nobody notices until a minimal image.
xz  # the vendored Bibata cursor tarball cannot be unpacked, so the desktop falls back to the default X cursor

# --- clipboard history (Super+v, dwm-clipmenu) ---
# In Void's main repo, so no third-party repo is needed.
clipmenu  # the clipboard-history keybind (Super+v) has nothing to show
clipnotify  # clipmenud cannot watch the clipboard, so no history is ever recorded

# --- privilege prompts ---
# autostart.sh launches the agent (see install-session-template.sh); no desktop
# environment is running to start it from /etc/xdg/autostart, so that .desktop
# file the package ships is never read on this setup.
#
# The agent is lxpolkit, which Void ships inside lxsession
# (/usr/bin/lxpolkit, checked in 0.5.6_1). Its binary is on PATH, so
# autostart.sh's launch line is unchanged.
lxsession  # no PolicyKit agent: any GUI action needing privileges is denied with no password prompt and often no error

# --- applications behind a keybind ---
# These two are applications rather than infrastructure, but they sit here on
# the criterion at the top of this file rather than on that distinction: each
# backs a key that does nothing at all when the package is missing, and says
# nothing about why. See config/sxhkd/sxhkdrc.
Thunar  # the file-manager keybind (super + e) opens nothing, and Thunar is also the mime handler for directories
firefox  # the browser keybind (super + shift + b) opens nothing, and firefox is the default handler for http/https
