${cacheDir}/cava-colors|c="${XDG_CONFIG_HOME:-$HOME/.config}/cava/config"; [ -f "$c" ] || exit 0; s="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/cava-colors"; sed -i '/^### dots-theme colors ###$/,$d' "$c"; { printf '%s\n' '### dots-theme colors ###'; cat "$s"; } >>"$c"; pkill -USR2 -x cava >/dev/null 2>&1 || true
# Written by scripts/theme/apply-templates.sh on every wallpaper change.
# Everything below the marker line above is regenerated — put your own
# settings above it. Source: config/theme/templates/always/cava.dcol.
# (The splice command derives its paths from XDG variables at run time
# rather than from the engine's substituted path tokens, so that a home
# directory containing a quote character cannot break its quoting.)

[color]

background = '#<wallbash_pry1>'
foreground = '#<wallbash_4xa6>'

gradient = 1
gradient_count = 8
gradient_color_1 = '#<wallbash_1xa4>'
gradient_color_2 = '#<wallbash_1xa6>'
gradient_color_3 = '#<wallbash_2xa5>'
gradient_color_4 = '#<wallbash_2xa7>'
gradient_color_5 = '#<wallbash_3xa6>'
gradient_color_6 = '#<wallbash_3xa8>'
gradient_color_7 = '#<wallbash_4xa7>'
gradient_color_8 = '#<wallbash_4xa9>'
