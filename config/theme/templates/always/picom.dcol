${confDir}/picom/picom.conf|pkill -USR1 -x picom >/dev/null 2>&1 || true
# Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
# Edit config/theme/templates/always/picom.dcol in the dots repo instead.
#
# picom has no include directive, so the whole picom.conf is generated
# rather than just a colors fragment. config/picom/picom.conf in the repo
# is the identical file with static fallback colors, deployed for the case
# where the theming engine has not run yet. config/picom is therefore
# deliberately NOT symlinked into ~/.config — a symlink would make this
# template write back into the repo on every wallpaper change.
#
# SIGUSR1 makes picom reload its config in place.

backend = "glx";
vsync = true;

# Deliberately restrained: shadows and a fade, no blur, no rounded-corner
# tricks, no animation. This runs on a suckless/dwm desktop where the
# compositor's job is tear-free rendering and a little depth, not effects.
shadow = true;
shadow-radius = 12;
shadow-opacity = 0.35;
shadow-offset-x = -12;
shadow-offset-y = -12;
shadow-color = "#<wallbash_pry1>";

shadow-exclude = [
    "class_g = 'dwm'",
    "class_g = 'dmenu'",
    "_GTK_FRAME_EXTENTS@",
    "window_type = 'dock'",
    "window_type = 'desktop'"
];

fading = true;
fade-in-step = 0.06;
fade-out-step = 0.06;
fade-delta = 8;
fade-exclude = [ "class_g = 'slock'" ];

# Full opacity everywhere by default — a wallpaper-derived theme already
# supplies the visual identity, and transparent terminals hurt contrast
# against an arbitrary wallpaper.
inactive-opacity = 1.0;
active-opacity = 1.0;
frame-opacity = 1.0;
inactive-opacity-override = false;

detect-rounded-corners = true;
detect-client-opacity = true;
detect-transient = true;
use-damage = true;

wintypes:
{
    tooltip = { fade = true; shadow = false; focus = true; };
    dock = { shadow = false; };
    dnd = { shadow = false; };
    popup_menu = { shadow = true; };
    dropdown_menu = { shadow = true; };
};
