${confDir}/picom/picom.conf|pkill -USR1 -x picom >/dev/null 2>&1 || true
# Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
# Edit config/theme/templates/always/picom.dcol in the dots repo instead.
#
# THIS TEMPLATE HAS NO COLOUR PLACEHOLDERS LEFT. It had exactly one,
# shadow-color, and dropping shadows for performance retired it. picom is
# therefore no longer a themed target in any real sense — this template
# regenerates a file identical to config/picom/picom.conf on every
# wallpaper change. It is kept anyway, deliberately, so that every
# deployed config still has a template behind it; the alternative
# (deleting it and letting the installer's copy stand alone) was weighed
# and declined.
#
# KEEP THIS FILE AND config/picom/picom.conf IN LOCKSTEP. They must carry
# identical settings: that one is what a fresh install gets, this one is
# what every wallpaper change writes over it. A setting changed in only
# one of them is silently reverted the first time the wallpaper changes.
# tests/picom-lockstep.sh generates from this template and diffs the two,
# so drift is a test failure rather than a surprise weeks later.
#
# picom has no include directive, so the whole picom.conf is generated
# rather than a colours fragment. config/picom is deliberately NOT
# symlinked into ~/.config — a symlink would make this template write back
# into the repo on every wallpaper change.
#
# SIGUSR1 makes picom reload its config in place.

backend = "glx";
vsync = true;

# Render only the damaged region rather than the whole screen each frame.
# The single largest win available and the reason the rest of this file can
# stay simple.
use-damage = true;

# Let a fullscreen window bypass the compositor entirely — no compositing
# work at all while a game or a video is fullscreen. picom triggers this
# when a window covers every monitor, is fullscreen per its WM hints, or
# sets _NET_WM_BYPASS_COMPOSITOR.
#
# Upstream is blunt that this is "known to cause flickering when
# redirecting/unredirecting windows", and that cost was accepted
# deliberately: the flicker is one frame on entering or leaving fullscreen,
# the saving is every frame in between. No unredir-if-possible-delay is
# set, so the bypass engages immediately.
#
# If one specific window ever misbehaves under this, exempt it with picom
# v13's WINDOW RULES `unredir` key rather than
# unredir-if-possible-exclude, which upstream discourages.
unredir-if-possible = true;

# No shadows. On a tiling dwm desktop windows rarely overlap, so shadows
# buy little separation, and drawing them is the largest constant
# per-frame cost left once blur is off. Dropping `shadow` also retires
# shadow-radius/opacity/offset-x/offset-y/color and the whole
# shadow-exclude list, which is why none of them appear below.
shadow = false;

fading = true;
fade-in-step = 0.06;
fade-out-step = 0.06;
fade-delta = 8;
fade-exclude = [ "class_g = 'slock'" ];

# Full opacity everywhere by default — a wallpaper-derived theme already
# supplies the visual identity, and transparent terminals hurt contrast
# against an arbitrary wallpaper. detect-client-opacity stays on so an
# application that sets _NET_WM_WINDOW_OPACITY for itself is still
# honoured; it costs one property read per window.
inactive-opacity = 1.0;
active-opacity = 1.0;
frame-opacity = 1.0;
inactive-opacity-override = false;
detect-client-opacity = true;

# Dim unfocused windows — the one visible effect, added 2026-10-05 as a
# PARTIAL DECISION REVERSAL of the 2026-08-07 performance pass (which left
# picom with nothing to show at all). Chosen as "simple and stable": a
# darkening pass per inactive window, the same on xrender and glx, with no
# transparency to hurt terminal contrast. Shadows, rounded corners and blur
# stay off for the reasons given above and below.
inactive-dim = 0.15;
#
# Focus from dwm's _NET_ACTIVE_WINDOW rather than X FocusIn events: dwm
# sets it on every focus change, and it is what the bar's title follows.
use-ewmh-active-win = true;
#
# Override-redirect windows count as focused, so they are never dimmed:
# dwm's own bar and systray, dmenu, dunst notifications and slock are all
# override-redirect, and a dimmed bar or lock screen would be a bug.
mark-ovredir-focused = true;
#
# A dialog and its parent count as focused together (WM_TRANSIENT_FOR), so
# opening a file chooser does not dim the window it belongs to. Absent
# until 2026-10-05 because, with nothing dimmed, it fed no decision.
detect-transient = true;
#
# detect-rounded-corners is deliberately absent. Its own documentation says
# you turn it on to match `rounded_corners` in conditions — nothing here
# does, and with shadow-exclude gone nothing can. Leaving it enabled costs
# a shape query per window for a condition that is never evaluated.

# Only tooltips still need an entry: every other wintype block existed to
# switch shadows off per window type, which `shadow = false` now does
# globally.
wintypes:
{
    tooltip = { fade = true; focus = true; };
};
