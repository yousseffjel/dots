${cacheDir}/qt-colors.conf|c="${XDG_CONFIG_HOME:-$HOME/.config}"; for t in "$c/qt5ct/qt5ct.conf" "$c/qt6ct/qt6ct.conf"; do [ -f "$t" ] && [ ! -L "$t" ] || continue; cp -p "$t" "$t.dots-tmp" && mv -f "$t.dots-tmp" "$t"; done
# Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
# Edit config/theme/templates/always/qt.dcol in the dots repo instead.
#
# The qt5ct/qt6ct colour scheme: ~/.config/qt5ct/qt5ct.conf and qt6ct.conf
# point their color_scheme_path here (written by the installer; a theme switch
# rewrites them). One file serves both: the format is the same.
#
# Each list is the 21 QPalette roles in order: WindowText, Button, Light,
# Midlight, Dark, Mid, Text, BrightText, ButtonText, Base, Window, Shadow,
# Highlight, HighlightedText, Link, LinkVisited, AlternateBase, NoRole,
# ToolTipBase, ToolTipText, PlaceholderText. The colours match gtk.css.
#
# Open Qt apps re-read it within a few seconds of a wallpaper change. They
# watch their config DIRECTORY, so the post-command re-places each conf (same
# content, a rename); an edit in place would go unseen.
[ColorScheme]
active_colors=#ff<wallbash_txt1>, #ff<wallbash_1xa2>, #ff<wallbash_1xa4>, #ff<wallbash_1xa3>, #ff<wallbash_1xa1>, #ff<wallbash_1xa2>, #ff<wallbash_txt1>, #ff<wallbash_txt1>, #ff<wallbash_txt1>, #ff<wallbash_1xa1>, #ff<wallbash_pry1>, #ff000000, #ff<wallbash_1xa7>, #ff<wallbash_pry1>, #ff<wallbash_1xa8>, #ff<wallbash_1xa6>, #ff<wallbash_pry2>, #ff<wallbash_pry1>, #ff<wallbash_1xa2>, #ff<wallbash_txt1>, #ff<wallbash_1xa6>
inactive_colors=#ff<wallbash_txt1>, #ff<wallbash_1xa2>, #ff<wallbash_1xa4>, #ff<wallbash_1xa3>, #ff<wallbash_1xa1>, #ff<wallbash_1xa2>, #ff<wallbash_txt1>, #ff<wallbash_txt1>, #ff<wallbash_txt1>, #ff<wallbash_1xa1>, #ff<wallbash_pry1>, #ff000000, #ff<wallbash_1xa7>, #ff<wallbash_pry1>, #ff<wallbash_1xa8>, #ff<wallbash_1xa6>, #ff<wallbash_pry2>, #ff<wallbash_pry1>, #ff<wallbash_1xa2>, #ff<wallbash_txt1>, #ff<wallbash_1xa6>
disabled_colors=#ff<wallbash_1xa6>, #ff<wallbash_1xa2>, #ff<wallbash_1xa4>, #ff<wallbash_1xa3>, #ff<wallbash_1xa1>, #ff<wallbash_1xa2>, #ff<wallbash_1xa6>, #ff<wallbash_1xa6>, #ff<wallbash_1xa6>, #ff<wallbash_1xa1>, #ff<wallbash_pry1>, #ff000000, #ff<wallbash_1xa3>, #ff<wallbash_1xa6>, #ff<wallbash_1xa6>, #ff<wallbash_1xa6>, #ff<wallbash_pry2>, #ff<wallbash_pry1>, #ff<wallbash_1xa2>, #ff<wallbash_1xa6>, #ff<wallbash_1xa5>
