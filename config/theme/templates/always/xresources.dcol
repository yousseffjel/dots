${cacheDir}/xresources|if command -v timeout >/dev/null 2>&1; then timeout 10 xrdb -merge "${cacheDir}/xresources"; else xrdb -merge "${cacheDir}/xresources"; fi
! Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
! Regenerate with: scripts/theme/wallpaper.sh <path>  (or theme-apply.sh)
!
! The post-command above is bounded at 10s, the same STEP_TIMEOUT that
! run_bounded uses in scripts/theme/reload.sh, and for the same reason: xrdb
! blocks on a hung X server, and apply-templates.sh runs its post-commands in
! sequence, so an unbounded one wedges every remaining template. Degrades to a
! bare xrdb where timeout is absent, matching run_bounded rather than failing.
!
! Every suckless tool in this repo reads its colors from here at startup
! (see the PATCHES.md under the patches dir of each suckless tool). Reload
! paths differ per tool and are driven by scripts/theme/reload.sh:
!   dwm    kill -HUP on the dwm pid (restartsig re-execs, re-reads these)
!   st     killall -USR1 st         (in-place, keeps the shell alive)
!   dmenu  next invocation
!   slock  next invocation
!
! ANSI color mapping: this palette is derived from a wallpaper, so it
! carries no inherent red/green/blue semantics. The 16 ANSI slots are
! filled from the accent ramps of the four primaries to stay visually
! coherent and readable rather than hue-accurate — a program that
! hardcodes "color1 means red" gets a palette-appropriate tint, not red.
!
! NOTE: xrdb pipes this file through cpp. A literal slash-star sequence
! anywhere below, even inside a bang comment, opens a C block comment and
! breaks the merge; an apostrophe opens a character literal and produces
! a warning on every merge. Keep both out of this file.

! --- generic (picked up by any Xft/X11 app that reads these) -----------
*.background:        #<wallbash_pry1>
*.foreground:        #<wallbash_txt1>
*.cursorColor:       #<wallbash_txt1>

*.color0:            #<wallbash_1xa1>
*.color1:            #<wallbash_2xa4>
*.color2:            #<wallbash_3xa4>
*.color3:            #<wallbash_4xa4>
*.color4:            #<wallbash_1xa5>
*.color5:            #<wallbash_2xa5>
*.color6:            #<wallbash_3xa5>
*.color7:            #<wallbash_txt1>
*.color8:            #<wallbash_1xa4>
*.color9:            #<wallbash_2xa7>
*.color10:           #<wallbash_3xa7>
*.color11:           #<wallbash_4xa7>
*.color12:           #<wallbash_1xa8>
*.color13:           #<wallbash_2xa8>
*.color14:           #<wallbash_3xa8>
*.color15:           #<wallbash_4xa9>

! --- dwm (xresources patch — see suckless/dwm/patches/PATCHES.md) ------
dwm.normbgcolor:     #<wallbash_pry1>
dwm.normfgcolor:     #<wallbash_txt1>
dwm.normbordercolor: #<wallbash_1xa3>
dwm.selbgcolor:      #<wallbash_1xa2>
dwm.selfgcolor:      #<wallbash_txt1>
dwm.selbordercolor:  #<wallbash_1xa7>

! --- st (xresources signal-reload patch) ------------------------------
st.background:       #<wallbash_pry1>
st.foreground:       #<wallbash_txt1>
st.cursorColor:      #<wallbash_txt1>
st.color0:           #<wallbash_1xa1>
st.color1:           #<wallbash_2xa4>
st.color2:           #<wallbash_3xa4>
st.color3:           #<wallbash_4xa4>
st.color4:           #<wallbash_1xa5>
st.color5:           #<wallbash_2xa5>
st.color6:           #<wallbash_3xa5>
st.color7:           #<wallbash_txt1>
st.color8:           #<wallbash_1xa4>
st.color9:           #<wallbash_2xa7>
st.color10:          #<wallbash_3xa7>
st.color11:          #<wallbash_4xa7>
st.color12:          #<wallbash_1xa8>
st.color13:          #<wallbash_2xa8>
st.color14:          #<wallbash_3xa8>
st.color15:          #<wallbash_4xa9>

! --- dmenu (xresources patch) -----------------------------------------
dmenu.background:    #<wallbash_pry1>
dmenu.foreground:    #<wallbash_txt1>
dmenu.selbackground: #<wallbash_1xa2>
dmenu.selforeground: #<wallbash_txt1>

! --- slock (xresources patch) -----------------------------------------
! initcolor is what the screen shows while locked and idle; keeping it at
! the darkest primary means the lock screen matches the desktop rather
! than flashing a hardcoded black.
slock.initcolor:     #<wallbash_pry1>
slock.inputcolor:    #<wallbash_1xa5>
slock.failedcolor:   #<wallbash_2xa6>
