${confDir}/fastfetch/config.jsonc|true
// Generated by scripts/theme/apply-templates.sh on every wallpaper change.
// DO NOT EDIT — this whole file is rewritten. Source:
// config/theme/templates/always/fastfetch.dcol.
//
// There is no static copy of this config under config/ in the repo: the
// template is the only authored version, the same arrangement gtk.css uses.
// scripts/install-restore-theme.sh creates ~/.config/fastfetch/ so the engine
// does not skip this template, and claims this path in the install manifest so
// that uninstall removes it.
//
// Colours come from the wallpaper. The `colors` module at the bottom prints
// the terminal's own 16-colour palette, which xresources.dcol and
// alacritty.dcol theme separately — so it doubles as a visual check that the
// whole engine ran, not just this template.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "fedora",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#<wallbash_1xa7>",
      "title": "#<wallbash_3xa8>"
    },
    "key": { "width": 9 }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "packages" },
    { "type": "shell", "key": "shell" },
    { "type": "wm", "key": "wm" },
    { "type": "terminal", "key": "terminal" },
    "break",
    { "type": "cpu", "key": "cpu" },
    { "type": "gpu", "key": "gpu" },
    { "type": "memory", "key": "memory" },
    { "type": "disk", "key": "disk", "folders": "/" },
    "break",
    "colors"
  ]
}
