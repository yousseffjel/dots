${confDir}/dunst/dunstrc|true
# Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
# Edit config/theme/templates/always/dunst.dcol in the dots repo instead.
#
# dunst has no include directive, so the whole dunstrc is generated rather
# than just a colors fragment. config/dunst/dunstrc in the repo is the
# identical file with static fallback colors, deployed for the case where
# the theming engine has not run yet. For that reason config/dunst is
# deliberately NOT symlinked into ~/.config — a symlink would make this
# template write back into the repo on every wallpaper change.
#
# No post-command: scripts/theme/reload.sh, which runs after every render,
# reloads the running dunst in place (`dunstctl reload`) and keeps its
# history and focus mode. Killing it here, as this did until 2026-10-15,
# emptied the notification centre and ended focus mode on every wallpaper
# change.

[global]
    monitor = 0
    follow = mouse
    width = (300, 450)
    origin = top-right
    # y clears dwm's top bar (font height + 2, ~21px at size=10) plus a
    # 12px gap; raise it if you enlarge the bar font in config.def.h.
    offset = (12, 36)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 0
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#<wallbash_1xa7>"
    separator_color = frame
    sort = yes

    font = monospace 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    sticky_history = yes
    history_length = 20
    browser = /usr/bin/env xdg-open
    # Rule scripts run only for a notification dunst SHOWS, so the sound
    # rule below is silent in focus mode; what it held back sounds once it
    # ends. true would also re-run them for one already on screen.
    always_run_script = false
    title = Dunst
    class = Dunst
    corner_radius = 6
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#<wallbash_pry1>"
    foreground = "#<wallbash_1xa6>"
    frame_color = "#<wallbash_1xa4>"
    timeout = 5

[urgency_normal]
    background = "#<wallbash_pry1>"
    foreground = "#<wallbash_txt1>"
    frame_color = "#<wallbash_1xa7>"
    timeout = 8

[urgency_critical]
    background = "#<wallbash_pry1>"
    foreground = "#<wallbash_txt1>"
    frame_color = "#<wallbash_2xa7>"
    timeout = 0

# The volume / mic / brightness pop-up (config/dwm/bin/dwm-osd) shows like
# any notification but is kept out of the history, so the notification
# centre (dwm-notify) lists real notifications only. tests/dunst-reload.sh
# holds this block identical in dunst.dcol and config/dunst/dunstrc.
[dots_osd]
    appname = dwm-osd
    history_ignore = yes

# Notification sounds (config/dwm/bin/dwm-sound-notify picks one by urgency;
# `dwm-sound off` silences it). tests/dunst-reload.sh holds this block
# identical in dunst.dcol and config/dunst/dunstrc.
[dots_sound]
    summary = "*"
    script = dwm-sound-notify
