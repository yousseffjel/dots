${cacheDir}/statusbar-colors.sh|pkill -x dwmblocks >/dev/null 2>&1 && (setsid dwmblocks >/dev/null 2>&1 &) || true
# Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
# Sourced by the dwmblocks block scripts; never executed directly.
#
# Two naming schemes on purpose:
#
# STATUS_* are ready-to-print status2d escape strings ('^c#RRGGBB^'), so a
# block script can emit one directly without building the escape itself.
# STATUS_RESET closes a color span ('^d^').
#
# COL_* are raw '#RRGGBB' values matching the names the existing block
# scripts in suckless/dwmblocks/scripts/ already source from their static
# dwm-colors palette. Emitting both means this file is a drop-in themed
# replacement for that static palette — the blocks re-theme with the
# wallpaper without each script having to be rewritten.

# --- status2d escape strings ------------------------------------------
STATUS_FG='^c#<wallbash_txt1>^'
STATUS_BG='^c#<wallbash_pry1>^'
STATUS_ACCENT1='^c#<wallbash_1xa7>^'
STATUS_ACCENT2='^c#<wallbash_2xa7>^'
STATUS_ACCENT3='^c#<wallbash_3xa7>^'
STATUS_ACCENT4='^c#<wallbash_4xa7>^'
STATUS_MUTED='^c#<wallbash_1xa5>^'
STATUS_WARN='^c#<wallbash_4xa6>^'
STATUS_URGENT='^c#<wallbash_2xa6>^'
STATUS_RESET='^d^'

# --- raw hex, matching suckless/dwmblocks/scripts/dwm-colors ----------
COL_CPU='#<wallbash_1xa7>'
COL_MEM='#<wallbash_3xa7>'
COL_CLOCK='#<wallbash_4xa7>'
