${cacheDir}/wallbash.vim|s="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/wallbash.vim"; for d in "$HOME/.vim" "${XDG_CONFIG_HOME:-$HOME/.config}/vim"; do [ -d "$d" ] || continue; mkdir -p "$d/colors" && cp -f "$s" "$d/colors/wallbash.vim"; done
" Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
" Edit config/theme/templates/always/vim.dcol in the dots repo instead.
"
" A dedicated colorscheme file, so it clobbers nothing of yours. Enable it
" with `colorscheme wallbash` in your vimrc. The whole file is regenerated
" on every wallpaper change; :colorscheme wallbash reloads it.
"
" The post-command re-derives $cacheDir/$confDir from the XDG variables
" rather than using the engine's ${cacheDir}/${confDir} tokens. Those are
" string-substituted into the command before it reaches the shell, so a
" home directory containing a quote character would break out of the
" surrounding quoting. Keep these two expressions in sync with
" scripts/theme/apply-templates.sh if its cacheDir definition ever moves.
"
" Rendered to $cacheDir first, then copied into every vim config dir that
" already exists (~/.vim and $XDG_CONFIG_HOME/vim). It is NOT written
" straight to ~/.config/vim/colors/ because the engine's install-check
" tests the target's parent directory, and vim creates neither ~/.config/vim
" nor a colors/ subdir on its own — so a direct target would skip as
" "not installed" for essentially every real user. An existing vim config
" dir is the honest signal that vim is set up here; if there is none, this
" is a no-op and the rendered colorscheme just sits in the cache.
"
" Only gui* attributes are emitted — the palette is 24-bit hex and has no
" 256-colour equivalents. Set `termguicolors` or this does nothing visible:
"     if has('termguicolors') | set termguicolors | endif
"
" Note on semantics: this palette carries no named red/green/yellow, only
" four primaries and their accent ramps. Diff and error highlights are
" therefore distinguished by accent *family* (primary 3 vs primary 4)
" rather than by hue, and may not read as red/green on every wallpaper.

hi clear
if exists('syntax_on')
  syntax reset
endif
let g:colors_name = 'wallbash'
set background=dark

" --- editor surfaces -------------------------------------------------------
hi Normal        guifg=#<wallbash_txt1> guibg=#<wallbash_pry1>
hi NormalNC      guifg=#<wallbash_txt1> guibg=#<wallbash_pry1>
hi CursorLine    guibg=#<wallbash_pry2> cterm=NONE gui=NONE
hi CursorColumn  guibg=#<wallbash_pry2>
hi ColorColumn   guibg=#<wallbash_pry2>
hi LineNr        guifg=#<wallbash_1xa4> guibg=#<wallbash_pry1>
hi CursorLineNr  guifg=#<wallbash_txt1> guibg=#<wallbash_pry2> gui=bold
hi SignColumn    guibg=#<wallbash_pry1>
hi VertSplit     guifg=#<wallbash_1xa3> guibg=#<wallbash_pry1>
hi Folded        guifg=#<wallbash_1xa6> guibg=#<wallbash_pry2>
hi FoldColumn    guifg=#<wallbash_1xa4> guibg=#<wallbash_pry1>
hi NonText       guifg=#<wallbash_1xa3>
hi SpecialKey    guifg=#<wallbash_1xa3>
hi Conceal       guifg=#<wallbash_1xa5> guibg=#<wallbash_pry1>
hi MatchParen    guifg=#<wallbash_pry1> guibg=#<wallbash_4xa5> gui=bold

" --- selection & search ----------------------------------------------------
hi Visual        guibg=#<wallbash_1xa3>
hi VisualNOS     guibg=#<wallbash_1xa3>
hi Search        guifg=#<wallbash_pry1> guibg=#<wallbash_3xa6>
hi IncSearch     guifg=#<wallbash_pry1> guibg=#<wallbash_4xa6>
hi CurSearch     guifg=#<wallbash_pry1> guibg=#<wallbash_4xa7>

" --- chrome ----------------------------------------------------------------
hi StatusLine    guifg=#<wallbash_txt3> guibg=#<wallbash_pry3> gui=NONE
hi StatusLineNC  guifg=#<wallbash_txt2> guibg=#<wallbash_pry2> gui=NONE
hi TabLine       guifg=#<wallbash_txt2> guibg=#<wallbash_pry2> gui=NONE
hi TabLineSel    guifg=#<wallbash_txt3> guibg=#<wallbash_pry3> gui=bold
hi TabLineFill   guibg=#<wallbash_pry1>
hi WildMenu      guifg=#<wallbash_pry1> guibg=#<wallbash_2xa6>
hi Pmenu         guifg=#<wallbash_txt2> guibg=#<wallbash_pry2>
hi PmenuSel      guifg=#<wallbash_pry1> guibg=#<wallbash_2xa6>
hi PmenuSbar     guibg=#<wallbash_pry2>
hi PmenuThumb    guibg=#<wallbash_1xa5>
hi Directory     guifg=#<wallbash_2xa6>
hi Title         guifg=#<wallbash_4xa7> gui=bold
hi Question      guifg=#<wallbash_3xa6>
hi MoreMsg       guifg=#<wallbash_3xa6>
hi ModeMsg       guifg=#<wallbash_txt1> gui=bold

" --- syntax ----------------------------------------------------------------
hi Comment       guifg=#<wallbash_1xa6> gui=italic
hi Constant      guifg=#<wallbash_3xa6>
hi String        guifg=#<wallbash_3xa5>
hi Character     guifg=#<wallbash_3xa5>
hi Number        guifg=#<wallbash_3xa7>
hi Boolean       guifg=#<wallbash_3xa7>
hi Float         guifg=#<wallbash_3xa7>
hi Identifier    guifg=#<wallbash_2xa6> gui=NONE
hi Function      guifg=#<wallbash_2xa7>
hi Statement     guifg=#<wallbash_4xa6> gui=NONE
hi Conditional   guifg=#<wallbash_4xa6>
hi Repeat        guifg=#<wallbash_4xa6>
hi Label         guifg=#<wallbash_4xa5>
hi Operator      guifg=#<wallbash_txt2>
hi Keyword       guifg=#<wallbash_4xa6>
hi Exception     guifg=#<wallbash_4xa8>
hi PreProc       guifg=#<wallbash_4xa7>
hi Include       guifg=#<wallbash_4xa7>
hi Define        guifg=#<wallbash_4xa7>
hi Macro         guifg=#<wallbash_4xa7>
hi PreCondit     guifg=#<wallbash_4xa7>
hi Type          guifg=#<wallbash_3xa7> gui=NONE
hi StorageClass  guifg=#<wallbash_3xa7>
hi Structure     guifg=#<wallbash_3xa7>
hi Typedef       guifg=#<wallbash_3xa7>
hi Special       guifg=#<wallbash_1xa8>
hi SpecialChar   guifg=#<wallbash_1xa8>
hi Delimiter     guifg=#<wallbash_txt2>
hi SpecialComment guifg=#<wallbash_1xa7> gui=italic
hi Debug         guifg=#<wallbash_4xa8>
hi Underlined    guifg=#<wallbash_2xa6> gui=underline
hi Ignore        guifg=#<wallbash_1xa4>
hi Todo          guifg=#<wallbash_pry1> guibg=#<wallbash_4xa6> gui=bold
hi Error         guifg=#<wallbash_pry1> guibg=#<wallbash_4xa8> gui=bold
hi ErrorMsg      guifg=#<wallbash_4xa8> guibg=#<wallbash_pry1>
hi WarningMsg    guifg=#<wallbash_4xa6>

" --- diff ------------------------------------------------------------------
hi DiffAdd       guifg=#<wallbash_pry1> guibg=#<wallbash_3xa5>
hi DiffChange    guifg=#<wallbash_pry1> guibg=#<wallbash_2xa5>
hi DiffDelete    guifg=#<wallbash_pry1> guibg=#<wallbash_4xa5>
hi DiffText      guifg=#<wallbash_pry1> guibg=#<wallbash_2xa7> gui=bold

" --- spell -----------------------------------------------------------------
hi SpellBad      guisp=#<wallbash_4xa7> gui=undercurl
hi SpellCap      guisp=#<wallbash_2xa7> gui=undercurl
hi SpellLocal    guisp=#<wallbash_3xa7> gui=undercurl
hi SpellRare     guisp=#<wallbash_1xa7> gui=undercurl
