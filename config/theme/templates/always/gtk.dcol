${confDir}/gtk-3.0/gtk.css|true
/* Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
 * Edit config/theme/templates/always/gtk.dcol in the dots repo instead.
 *
 * Accent overrides layered on top of whatever dark GTK theme is named in
 * ~/.config/gtk-3.0/settings.ini (deployed by the installer as part of
 * sub-task 7, alongside Papirus-Dark icons). This file does not attempt
 * to be a full GTK theme — it recolors the accent-bearing widgets so GTK
 * apps stop clashing with the wallpaper-derived palette, and leaves
 * layout and widget geometry to the base theme.
 *
 * No post-command: GTK 3 applications re-read gtk.css on their own when
 * the file changes (GtkCssProvider watches it), so there is nothing to
 * signal. Apps already running that cache colors internally pick it up on
 * next launch.
 */

@define-color theme_bg_color #<wallbash_pry1>;
@define-color theme_base_color #<wallbash_1xa1>;
@define-color theme_fg_color #<wallbash_txt1>;
@define-color theme_text_color #<wallbash_txt1>;

@define-color theme_selected_bg_color #<wallbash_1xa7>;
@define-color theme_selected_fg_color #<wallbash_pry1>;

@define-color insensitive_bg_color #<wallbash_1xa2>;
@define-color insensitive_fg_color #<wallbash_1xa6>;

@define-color borders #<wallbash_1xa3>;
@define-color unfocused_borders #<wallbash_1xa2>;

@define-color warning_color #<wallbash_4xa6>;
@define-color error_color #<wallbash_2xa6>;
@define-color success_color #<wallbash_3xa6>;

/* Accent-bearing widgets. Kept to the few selectors that actually carry
 * the accent — a broader sweep would fight the base theme's own rules. */
selection,
:selected,
*:selected {
    background-color: @theme_selected_bg_color;
    color: @theme_selected_fg_color;
}

progressbar progress,
scale highlight,
scale fill {
    background-color: @theme_selected_bg_color;
}

check:checked,
radio:checked,
switch:checked {
    background-color: @theme_selected_bg_color;
    border-color: @theme_selected_bg_color;
}

entry:focus,
spinbutton:focus {
    border-color: @theme_selected_bg_color;
}

link,
*:link {
    color: #<wallbash_1xa8>;
}
