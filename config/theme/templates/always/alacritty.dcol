${cacheDir}/alacritty-colors.toml|true
# Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
# Edit config/theme/templates/always/alacritty.dcol in the dots repo instead.
#
# Pulled in by config/alacritty/alacritty.toml's `general.import`. That
# indirection is the whole point: config/alacritty/ is symlinked into this
# repo, so the engine must never write alacritty.toml itself. Rendering a
# separate colours-only file into the cache keeps the repo clean while
# leaving the user's config fully symlinkable — a third pattern alongside
# the copied files (dunst, picom) and the post-command installers (vim).
#
# No post-command on purpose, and no step in scripts/theme/reload.sh —
# alacritty is expected to pick a rewrite up on its own via
# live_config_reload. That rests on an inference, not an observation: its
# startup log lists imports as loaded config files, and that set is what the
# watcher watches. The reload itself was never reproduced end to end. If an
# open terminal is ever left on the stale palette after a wallpaper change,
# add an explicit reload step rather than assuming the render failed.
#
# Absence is a supported state: alacritty starts cleanly when this file has
# not been generated yet and falls back to its built-in colours. Verified on
# 0.17.0, the version Fedora 44 ships.
#
# The ANSI mapping below is deliberately IDENTICAL to the st/generic mapping
# in xresources.dcol. Both terminals are in daily use (alacritty primary, st
# the no-GPU fallback), and a program that paints with ANSI colours must not
# change appearance depending on which one launched it. If you re-map a slot
# there, re-map it here in the same commit.
#
# As in xresources.dcol, the 16 ANSI slots carry no hue semantics — the
# palette is derived from a wallpaper, so "red" is whichever accent ramp sits
# in that slot, chosen for coherence and legibility rather than hue accuracy.

[colors.primary]
background = "#<wallbash_pry1>"
foreground = "#<wallbash_txt1>"

[colors.cursor]
text   = "#<wallbash_pry1>"
cursor = "#<wallbash_txt1>"

[colors.vi_mode_cursor]
text   = "#<wallbash_pry1>"
cursor = "#<wallbash_1xa7>"

# Matches dwm's selbgcolor and dmenu's selbackground (both 1xa2 in
# xresources.dcol) so a selection reads the same across the desktop.
[colors.selection]
text       = "#<wallbash_txt1>"
background = "#<wallbash_1xa2>"

[colors.normal]
black   = "#<wallbash_1xa1>"
red     = "#<wallbash_2xa4>"
green   = "#<wallbash_3xa4>"
yellow  = "#<wallbash_4xa4>"
blue    = "#<wallbash_1xa5>"
magenta = "#<wallbash_2xa5>"
cyan    = "#<wallbash_3xa5>"
white   = "#<wallbash_txt1>"

[colors.bright]
black   = "#<wallbash_1xa4>"
red     = "#<wallbash_2xa7>"
green   = "#<wallbash_3xa7>"
yellow  = "#<wallbash_4xa7>"
blue    = "#<wallbash_1xa8>"
magenta = "#<wallbash_2xa8>"
cyan    = "#<wallbash_3xa8>"
white   = "#<wallbash_4xa9>"
