${cacheDir}/gtkrc-2.0|s="${XDG_CACHE_HOME:-$HOME/.cache}/dots/theme/gtkrc-2.0"; t="$HOME/.gtkrc-2.0"; if [ -e "$t" ] || [ -L "$t" ]; then head -n1 "$t" 2>/dev/null | grep -qF 'Generated by scripts/theme/apply-templates.sh' || exit 0; fi; cp -f "$s" "$t.dots-tmp" && mv -f "$t.dots-tmp" "$t"
# Generated by scripts/theme/apply-templates.sh — DO NOT EDIT.
# Edit config/theme/templates/always/gtk2.dcol in the dots repo instead.
#
# Colours for GTK2 applications, from the wallpaper palette. The one that
# matters here is lxpolkit, the password prompt for privileged actions.
#
# This is a whole theme, not overrides on top of one: Fedora 44 ships no
# dark GTK2 theme (gnome-themes-extra, which carried Adwaita-dark for GTK2,
# was retired). xsettingsd names Adwaita-dark to GTK2 as well, GTK2 does not
# find it and falls back to its built-in default, and these styles paint
# that default. Plain rc styles only — no engine, so nothing else needs
# installing. Icons, font and cursor still come from xsettingsd.
#
# Rendered to the theme cache, then moved into ~/.gtkrc-2.0 by the
# post-command — a target outside ~/.config, which the engine's tokens cannot
# name. It only ever replaces a ~/.gtkrc-2.0 whose first line is the one
# above: a gtkrc of your own, or a symlink to one, is left alone, and then
# GTK2 apps are simply not themed. Delete it to get this one. GTK2 reads the
# file at startup, so an open window keeps the old colours until restarted.

style "dots-default" {
    bg[NORMAL]        = "#<wallbash_pry1>"
    bg[PRELIGHT]      = "#<wallbash_1xa2>"
    bg[ACTIVE]        = "#<wallbash_1xa3>"
    bg[SELECTED]      = "#<wallbash_1xa7>"
    bg[INSENSITIVE]   = "#<wallbash_pry1>"

    fg[NORMAL]        = "#<wallbash_txt1>"
    fg[PRELIGHT]      = "#<wallbash_txt1>"
    fg[ACTIVE]        = "#<wallbash_txt1>"
    fg[SELECTED]      = "#<wallbash_pry1>"
    fg[INSENSITIVE]   = "#<wallbash_1xa6>"

    base[NORMAL]      = "#<wallbash_1xa1>"
    base[PRELIGHT]    = "#<wallbash_1xa2>"
    base[ACTIVE]      = "#<wallbash_1xa6>"
    base[SELECTED]    = "#<wallbash_1xa7>"
    base[INSENSITIVE] = "#<wallbash_1xa2>"

    text[NORMAL]      = "#<wallbash_txt1>"
    text[PRELIGHT]    = "#<wallbash_txt1>"
    text[ACTIVE]      = "#<wallbash_pry1>"
    text[SELECTED]    = "#<wallbash_pry1>"
    text[INSENSITIVE] = "#<wallbash_1xa6>"
}

# Hovered and open menu entries take the accent, like gtk.css's :selected.
style "dots-menuitem" = "dots-default" {
    bg[PRELIGHT]      = "#<wallbash_1xa7>"
    fg[PRELIGHT]      = "#<wallbash_pry1>"
}

style "dots-tooltip" = "dots-default" {
    bg[NORMAL]        = "#<wallbash_1xa2>"
    fg[NORMAL]        = "#<wallbash_txt1>"
}

class "GtkWidget" style "dots-default"
widget_class "*<GtkMenuItem>*" style "dots-menuitem"
widget "gtk-tooltip*" style "dots-tooltip"
