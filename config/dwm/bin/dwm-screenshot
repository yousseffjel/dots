#!/usr/bin/env bash
# dwm-screenshot — dmenu-driven screenshots via maim + slop + xclip.
#
# Two prompts, mode then destination, mirroring dwm-powermenu's structure:
#
#   screenshot>  full | monitor | window | region
#
# full is the whole X screen, every monitor at once; monitor is the one
# under the pointer (dwm-lib-monitor.sh).
#   dest>        clipboard | file | both
#
# Either prompt is skipped when the matching flag is passed, so a keybind can
# jump straight to one combination. Escape at either prompt aborts silently.
#
#   dwm-screenshot                        both prompts
#   dwm-screenshot --region               region, then ask where it goes
#   dwm-screenshot --region --clipboard   no prompts at all
#
#   dwm-screenshot --monitor --both       this monitor, saved and copied
#   dwm-screenshot --delay 3 --region --clipboard
#                                         3 s to open a menu, then the region
#
# --delay and --no-grab exist for dropdowns and menus: a key grab takes the
# focus off the window while it is held, and a browser closes its dropdown on
# that. --no-grab runs slop without its keyboard grab, so Escape cannot
# cancel; dwm-shotkey (Super+a, read without a grab) cancels on Escape for it.
# --delay is for a shot started from a grabbed key: press it, then open the
# menu before the delay runs out.
#
# Bound to Print, Shift+Print, Super+Shift+a (region -> clipboard after 3 s)
# and Super+Alt+p (full -> both) in config/sxhkd/sxhkdrc; Super+a (region ->
# clipboard, --no-grab) is dwm-shotkey's. Nothing here needs a dwm rebuild:
# none of those chords is in dwm's keys[], so sxhkd may grab them freely.
#
# flameshot was rejected for this job because it is Qt, and the desktop is
# GTK-only (roster Epic locked decision 3).
set -euo pipefail

red() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

# xdg_dir (dwm-lib-xdg.sh); a missing helper degrades to the fixed fallback.
# shellcheck source=dwm-lib-xdg.sh
source "${BASH_SOURCE[0]%/*}/dwm-lib-xdg.sh" 2>/dev/null || xdg_dir() { printf '%s' "$2"; }

# screenshots/ in the XDG pictures dir; DOTS_SCREENSHOT_DIR overrides it all.
SHOT_DIR="${DOTS_SCREENSHOT_DIR:-$(xdg_dir PICTURES "$HOME/Pictures")/screenshots}"
NAME_FMT="dots-screenshot-%Y%m%d-%H%M%S.png"

# Colours are deliberately NOT passed to dmenu: it reads them from the X
# resource database, and explicit -nb/-nf/-sb/-sf would override the theme.
# Same reasoning as dwm-powermenu.
FONT="monospace:size=10"
DMENU_OPTS=(-i -fn "$FONT")

# The pointer is composited into the image by default. It is noise in every
# mode here — in region mode it sits exactly where the drag ended. Drop the
# flag from CAPTURE_OPTS to get it back.
CAPTURE_OPTS=(--hidecursor)

# slop's rectangle: 2px, and see selector_color below for the colour.
SLOP_BORDER=2
# Same-second names tried before giving up (an unwritable dir, say).
RESERVE_TRIES=99

TMP=""
cleanup() { if [[ -n "$TMP" ]]; then rm -f "$TMP"; fi; }
trap cleanup EXIT

usage() {
    echo "usage: dwm-screenshot [--delay SECONDS] [--no-grab] [--full|--monitor|--window|--region] [--clipboard|--file|--both]"
}

# Notifications are a nicety, never a dependency — same contract as
# scripts/theme/wallpaper.sh.
notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a "dots-screenshot" -i camera-photo "$@" || true
}

require() {
    command -v "$1" >/dev/null 2>&1 && return 0
    red "dwm-screenshot: $1 is not installed ($2)"
    return 1
}

# --- capture -----------------------------------------------------------
# hex2rgba, selector_color, active_window and capture live in the sourced
# dwm-lib-screenshot.sh, split out at the 250-line cap (2026-10-12). They ARE
# the screenshot, so unlike dwm-lib-xdg.sh a missing one is a hard error.
# shellcheck source=dwm-lib-screenshot.sh
if ! source "${BASH_SOURCE[0]%/*}/dwm-lib-screenshot.sh" 2>/dev/null; then
    notify -u critical "Screenshot failed" "dwm-lib-screenshot.sh is missing next to dwm-screenshot"
    red "dwm-screenshot: dwm-lib-screenshot.sh is missing next to this script"
    exit 1
fi

# monitor_geometry (dwm-lib-monitor.sh). Only --monitor needs it, so a
# missing one fails that mode alone, like a missing xprop fails --window.
# shellcheck source=dwm-lib-monitor.sh
source "${BASH_SOURCE[0]%/*}/dwm-lib-monitor.sh" 2>/dev/null || monitor_geometry() {
    red "dwm-screenshot: dwm-lib-monitor.sh is missing next to this script"
    return 1
}

# Checked here rather than up front: --file needs no clipboard at all, and
# failing that combination on a missing xclip would be gratuitous.
to_clipboard() {
    require xclip "clipboard delivery" || return 1
    xclip -selection clipboard -t image/png -i "$1"
}

# reserve <path> — creates the first free one of path, path-2, path-3 …
# and prints it. NAME_FMT has seconds resolution, so two captures in one
# second shared a name and the second replaced the first. noclobber makes
# the create atomic: two at once cannot both win the same name.
reserve() {
    local base="${1%.*}" ext="${1##*.}" try="$1" n=1
    until (set -C && : >"$try") 2>/dev/null; do
        n=$((n + 1))
        ((n <= RESERVE_TRIES)) || return 1
        try="$base-$n.$ext"
    done
    printf '%s\n' "$try"
}

# The shutter (dwm-sound, docs/DESKTOP.md § Sounds) for a delivered shot.
# Its notification is low, which dwm-sound-notify keeps silent, so a shot
# makes one sound, not two.
shutter() {
    "${BASH_SOURCE[0]%/*}/dwm-sound" screen-capture >/dev/null 2>&1 &
}

# Consumes $TMP. For file/both the temp is moved into place rather than
# copied, so the EXIT trap's rm finds nothing left to remove. As with
# capture(), $1 is validated by the caller rather than re-checked here.
deliver() {
    local dest="$1" src="$2" target
    case "$dest" in
        clipboard)
            to_clipboard "$src"
            shutter
            notify -u low "Screenshot" "Copied to clipboard"
            ;;
        file | both)
            mkdir -p "$SHOT_DIR"
            if ! target="$(reserve "$SHOT_DIR/$(date +"$NAME_FMT")")"; then
                notify -u critical "Screenshot failed" "cannot create a file in $SHOT_DIR"
                red "dwm-screenshot: cannot create a file in $SHOT_DIR"
                return 1
            fi
            mv "$src" "$target"
            shutter
            # The file is already safe on disk by this point, so a failing
            # clipboard step must not take the whole run down with it — it
            # downgrades the message instead.
            if [[ "$dest" == "both" ]] && to_clipboard "$target"; then
                notify -u low "Screenshot" "Saved to $target and copied"
            else
                notify -u low "Screenshot" "Saved to $target"
            fi
            ;;
    esac
}

# --- argument parsing --------------------------------------------------
MODE=""
DEST=""
DELAY=0
# Read by capture() in dwm-lib-screenshot.sh.
NO_GRAB=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --delay)
            if [[ ! "${2-}" =~ ^[0-9]+$ ]]; then
                red "dwm-screenshot: --delay needs a whole number of seconds"
                exit 1
            fi
            DELAY="$2"
            shift
            ;;
        --full | --monitor | --window | --region) MODE="${1#--}" ;;
        --clipboard | --file | --both) DEST="${1#--}" ;;
        --no-grab) NO_GRAB=1 ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            red "dwm-screenshot: unknown option '$1'"
            usage >&2
            exit 1
            ;;
    esac
    shift
done

require maim "the capture backend" || exit 1

# An unset mode or destination is prompted for. dmenu exits non-zero on
# Escape, which is an abort, not an error.
if [[ -z "$MODE" ]]; then
    MODE="$(printf '%s\n' full monitor window region \
        | dmenu "${DMENU_OPTS[@]}" -l 4 -p "screenshot>")" || exit 0
fi
if [[ -z "$DEST" ]]; then
    DEST="$(printf '%s\n' clipboard file both \
        | dmenu "${DMENU_OPTS[@]}" -l 3 -p "dest>")" || exit 0
fi

# Both values are validated before anything is captured. dmenu returns
# whatever was typed when it matches no entry, and finding that out from
# deliver() would mean a wasted capture — in region mode, a whole selection
# drag performed for nothing.
case "$MODE" in
    full | monitor | window | region) ;;
    *)
        red "dwm-screenshot: unknown mode '$MODE'"
        exit 1
        ;;
esac
case "$DEST" in
    clipboard | file | both) ;;
    *)
        red "dwm-screenshot: unknown destination '$DEST'"
        exit 1
        ;;
esac

# After the prompts, so the time is spent on the screen, not in dmenu.
if ((DELAY > 0)); then
    # Low, so silent: the shutter is the shot's one sound.
    notify -u low -t "$((DELAY * 1000))" "Screenshot in ${DELAY}s" "Open the menu now"
    sleep "$DELAY"
fi

TMP="$(mktemp -t dwm-screenshot.XXXXXX.png)"

rc=0
capture "$MODE" "$TMP" || rc=$?
# 2 is "user pressed Escape in slop" — silent, successful exit.
if ((rc == 2)); then exit 0; fi
if ((rc != 0)); then exit "$rc"; fi

if [[ ! -s "$TMP" ]]; then
    red "dwm-screenshot: capture produced an empty file"
    exit 1
fi

deliver "$DEST" "$TMP"
