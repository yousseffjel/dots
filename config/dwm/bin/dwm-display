#!/usr/bin/env bash
# dwm-display — dmenu-driven monitor layout switcher.
#
# Bound to Super+Shift+d in config/sxhkd/sxhkdrc. Offers autorandr's saved profiles
# first when autorandr is installed, then a set of xrandr presets derived from
# whatever is actually connected.
#
# WHY NOT arandr. arandr is a GTK GUI for authoring a layout once and saving
# the xrandr command it produces — the authoring half. autorandr (desktop.lst)
# covers the automatic half: it fingerprints connected monitors by EDID and
# re-applies the matching profile on hotplug, via the udev rule its package
# ships. What was missing between them was a keybind for "put the displays how
# I want them, now", which is this. Scope C locked decision 4.
#
# Presets are DERIVED from `xrandr`, never hardcoded: output names differ per
# machine and per GPU driver (eDP-1 vs eDP1 vs LVDS-1), so a fixed list would
# be wrong on the first laptop it met.
#
# usage: dwm-display [--list]
set -euo pipefail

# --help answers before anything opens a menu (tests/dwm-help.sh).
case "${1:-}" in
    -h | --help)
        echo "usage: dwm-display [--list] — monitor layout menu: autorandr profiles, then xrandr presets (Super+Shift+d)"
        exit 0
        ;;
esac

red() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

FONT="monospace:size=10"
# Colours deliberately not passed — dmenu reads them from the X resource
# database, and explicit -nb/-nf/-sb/-sf would pin the menu to compiled-in
# colours and break theming. Same reasoning as dwm-powermenu.
DMENU_OPTS=(-i -fn "$FONT")

if ! command -v xrandr >/dev/null 2>&1; then
    red "dwm-display: xrandr not found — it is declared in packages/desktop.lst"
    exit 1
fi

# Connected outputs, in xrandr's own order, one "name active primary" line
# each. Matching $2 exactly avoids the "disconnected" trap a bare /connected/
# pattern walks into — the same care dwm-brightness takes. An output is
# active when a geometry (WxH+X+Y) follows "connected" or "primary".
outputs() {
    xrandr 2>/dev/null | awk '$2 == "connected" {
        p = ($3 == "primary"); g = p ? $4 : $3
        print $1, (g ~ /^[0-9]+x[0-9]+\+/), p
    }'
}

OUTPUTS=()
declare -A ACTIVE=()
PRIMARY=""
while read -r name active primary; do
    OUTPUTS+=("$name")
    ACTIVE[$name]="$active"
    if ((primary)); then PRIMARY="$name"; fi
done < <(outputs)
if ((${#OUTPUTS[@]} == 0)); then
    red "dwm-display: no connected outputs (or xrandr is unavailable)"
    exit 1
fi
# The output xrandr marks primary; taking the first one instead moved the
# primary flag with every preset.
PRIMARY="${PRIMARY:-${OUTPUTS[0]}}"
OTHERS=()
for out in "${OUTPUTS[@]}"; do [[ "$out" == "$PRIMARY" ]] || OTHERS+=("$out"); done

# on <output> — the xrandr options that leave it enabled: nothing for one
# already on, so its mode survives (--auto reset it to the PREFERRED mode:
# 1920x1080 became 850x1001 on the VM, and on real hardware it undoes any
# mode or refresh rate picked by hand), --auto for one that is off.
on() {
    if ((ACTIVE[$1])); then
        printf -- '--output %s' "$1"
    else
        printf -- '--output %s --auto' "$1"
    fi
}

# Menu entries as "label<TAB>command". Built as two parallel arrays rather than
# an associative one so the menu order is stable and reproducible.
LABELS=()
COMMANDS=()

add() {
    LABELS+=("$1")
    COMMANDS+=("$2")
}

# autorandr's saved profiles first: if the user has curated one for this exact
# set of monitors, it beats anything generated below. Silently skipped when
# autorandr is absent — it is a desktop.lst package, so a failed install is
# already reported loudly elsewhere and this must still work without it.
HAVE_AUTORANDR=0
if command -v autorandr >/dev/null 2>&1; then
    HAVE_AUTORANDR=1
    while IFS= read -r profile; do
        [[ -n "$profile" ]] && add "profile: $profile" "autorandr --load $profile"
    done < <(autorandr --list 2>/dev/null || true)
fi

# One "only this output" entry per connected monitor, each turning every other
# one off in the same xrandr call — a single call so the server never passes
# through a state with no enabled output.
for out in "${OUTPUTS[@]}"; do
    cmd="xrandr $(on "$out") --primary"
    for other in "${OUTPUTS[@]}"; do
        [[ "$other" == "$out" ]] || cmd+=" --output $other --off"
    done
    add "only $out" "$cmd"
done

# Multi-output arrangements only make sense with something to arrange.
if ((${#OUTPUTS[@]} > 1)); then
    for out in "${OTHERS[@]}"; do
        add "extend $out right of $PRIMARY" \
            "xrandr $(on "$PRIMARY") --primary $(on "$out") --right-of $PRIMARY"
        add "extend $out left of $PRIMARY" \
            "xrandr $(on "$PRIMARY") --primary $(on "$out") --left-of $PRIMARY"
        add "mirror $out onto $PRIMARY" \
            "xrandr $(on "$PRIMARY") --primary $(on "$out") --same-as $PRIMARY"
    done
    cmd="xrandr"
    for out in "${OUTPUTS[@]}"; do cmd+=" $(on "$out")"; done
    add "all on" "$cmd"
fi

# Last: autorandr --save writes the CURRENT layout, so it is what you pick
# after arranging. A saved profile is re-applied by Void's udev rule
# (autorandr --change) when the same screens are plugged in again, and at
# every login by autostart.sh. Dispatch knows it by its label: the command
# needs a name first (save_layout).
SAVE_LABEL="save this layout as a profile"
if ((HAVE_AUTORANDR)); then
    add "$SAVE_LABEL" "autorandr --save <name>"
fi

if [[ "${1:-}" == "--list" ]]; then
    for i in "${!LABELS[@]}"; do
        printf '%s\t%s\n' "${LABELS[$i]}" "${COMMANDS[$i]}"
    done
    exit 0
elif [[ -n "${1:-}" ]]; then
    red "dwm-display: unknown option '$1'"
    echo "usage: dwm-display [--list]" >&2
    exit 1
fi

notify() {
    command -v notify-send >/dev/null 2>&1 || return 0
    notify-send -a dwm-display "display" "$1" || true
}

# save_layout — ask for a profile name (the existing ones are offered, to
# overwrite), then autorandr --save. Escape at either prompt saves nothing.
# The name becomes a directory under ~/.config/autorandr, so anything but
# letters, digits, . _ - is refused, and it may not start with a dash or dot.
save_layout() {
    local name profiles
    profiles="$(autorandr --list 2>/dev/null || true)"
    name="$(printf '%s\n' "$profiles" | dmenu "${DMENU_OPTS[@]}" -p "profile name>")" || return 0
    [[ -n "$name" ]] || return 0
    if [[ ! "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        red "dwm-display: '$name' is not a profile name (letters, digits, . _ -)"
        notify "not saved: '$name' is not a profile name (letters, digits, . _ -)"
        return 1
    fi
    # Read once, not `autorandr --list | grep -q`: under pipefail a grep that
    # stops early reads as a failure, and the overwrite would go unasked.
    if grep -qxF -- "$name" <<<"$profiles"; then
        [[ "$(printf 'no\nyes\n' | dmenu "${DMENU_OPTS[@]}" -p "overwrite profile $name?")" == yes ]] || return 0
        autorandr --save "$name" --force || {
            red "dwm-display: autorandr could not save '$name'"
            return 1
        }
    else
        autorandr --save "$name" || {
            red "dwm-display: autorandr could not save '$name'"
            return 1
        }
    fi
    notify "saved this layout as profile $name — it comes back when these screens are plugged in"
}

# `|| exit 0` on the dmenu call, not `|| exit 1`: dismissing the menu with
# Escape is a normal way to use it, not an error.
choice="$(printf '%s\n' "${LABELS[@]}" | dmenu "${DMENU_OPTS[@]}" -l 10 -p "display>")" || exit 0
[[ -n "$choice" ]] || exit 0
if [[ "$choice" == "$SAVE_LABEL" ]] && ((HAVE_AUTORANDR)); then
    save_layout
    exit
fi

for i in "${!LABELS[@]}"; do
    if [[ "${LABELS[$i]}" == "$choice" ]]; then
        # Word splitting is intended here: COMMANDS holds a command line built
        # from xrandr output names, which cannot contain whitespace.
        # shellcheck disable=SC2086
        if ! ${COMMANDS[$i]}; then
            red "dwm-display: '$choice' failed"
            exit 1
        fi
        # feh painted the root window at the OLD size; re-run it at the new
        # one. A profile load also triggers autorandr's postswitch hook, which
        # does the same — twice is harmless, and the xrandr presets have no
        # hook at all. A wallpaper failure is not a layout failure.
        if [[ -x "$HOME/.fehbg" ]]; then
            "$HOME/.fehbg" >/dev/null 2>&1 || true
        fi
        notify "$choice"
        exit 0
    fi
done

red "dwm-display: '$choice' is not one of the offered layouts"
exit 1
