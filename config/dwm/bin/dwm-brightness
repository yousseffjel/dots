#!/usr/bin/env bash
# dwm-brightness — screen brightness: the backlight on a laptop, xrandr gamma
# on a desktop.
#
# Two paths, chosen per call by what the machine has:
#
#   backlight  brightnessctl --class=backlight, when a /sys/class/backlight
#              device answers. Only a laptop has one, and only a laptop gets
#              brightnessctl (packages/laptop.lst, installed by dots drivers).
#              Void builds it without logind: it writes /sys through the
#              udev rule it ships, which grants the `video` group (the
#              services stage adds; install-services-groups.sh). This dims
#              the lamp.
#   gamma      xrandr --brightness, everywhere else. A desktop GPU exposes no
#              backlight, so this scales the output signal instead: the panel
#              keeps drawing full power and the image gets darker (scope-b
#              decision 12; ddcutil was rejected on cost, ~100-300ms per DDC/CI
#              call plus an i2c-dev udev rule). dwm-nightlight shares the gamma
#              ramps, so this path defers to it while it runs (see below).
#
# scope-h (2026-10-13) added the backlight path. A desktop behaves exactly as
# it did before.
#
# Bound to XF86MonBrightnessUp/Down in config/sxhkd/sxhkdrc, which fires
# `pkill -RTMIN+6 dwmblocks` afterwards. `get` is the read side for that
# status block (roster Epic sub-task 7), which polls at interval 0, and
# `mode` tells it which label to show.
#
# `sync` re-applies the last gamma level. A screen X turns on again (a
# hotplug, a dwm-display preset, an autorandr profile) starts at full
# brightness while the others stay dimmed, so dwm-display and the autorandr
# hook config/autorandr/postswitch.d/20-dots-brightness call it after every
# switch. A backlight is not reset by a display change, so it does nothing
# there, and nothing either until a level has been set once.
#
# usage: dwm-brightness get|up|down|set <10-100>|mode|sync
set -euo pipefail

red() { printf '\033[31m%s\033[0m\n' "$*" >&2; }

STEP=10
# Never allow 0: an all-black screen has to be undone from a terminal you
# can no longer see. 10% is dim enough to be useful and still readable.
MIN=10
MAX=100

usage() {
    echo "usage: dwm-brightness get|up|down|set <${MIN}-${MAX}>|mode|sync"
}

# The first backlight device's `brightnessctl -m` line,
# "intel_backlight,backlight,4882,51%,9600", or failure when there is no
# brightnessctl or no backlight device (it then exits 1, "Failed to read any
# devices of class 'backlight'").
backlight_info() {
    local out
    command -v brightnessctl >/dev/null 2>&1 || return 1
    out="$(brightnessctl --class=backlight -m info 2>/dev/null)" || return 1
    [[ -n "$out" ]] || return 1
    printf '%s\n' "${out%%$'\n'*}"
}

mode() {
    if backlight_info >/dev/null; then echo backlight; else echo gamma; fi
}

# While dwm-nightlight's daemon runs it owns the gamma ramps: the filter and
# this script both write them, and a ramp set here would be replaced on the
# daemon's next tick. So the level becomes a stored number that the daemon
# folds into every apply, and changing it asks for an apply right away.
# Without the daemon nothing here changes: xrandr --brightness, as before.
#
# The path is resolved only once the daemon is known to run: reading $HOME at
# the top would turn `set -u` into an abort for a caller without it, on the
# path that never needed it.
nightlight_file() {
    printf '%s\n' "${XDG_STATE_HOME:-$HOME/.local/state}/dots/nightlight/brightness"
}

nightlight_active() {
    command -v dwm-nightlight >/dev/null 2>&1 || return 1
    command -v pgrep >/dev/null 2>&1 || return 1
    pgrep -f '/dwm-nightlight daemon$' >/dev/null 2>&1
}

# Where `sync` finds the last gamma level. Resolved per call, and absent rather
# than an abort when neither variable is set (the reason nightlight_file is
# lazy too).
level_file() {
    if [[ -n "${XDG_STATE_HOME:-}" ]]; then
        printf '%s\n' "$XDG_STATE_HOME/dots/brightness"
    elif [[ -n "${HOME:-}" ]]; then
        printf '%s\n' "$HOME/.local/state/dots/brightness"
    else
        return 1
    fi
}

# Stored on both gamma paths, the nightlight one included: once the daemon
# stops, its last ramp is what the screens show, and a sync must not put back
# an older level. A failed write costs only the next sync, so it is said and
# the change itself still succeeds.
store_level() {
    local file
    file="$(level_file)" || return 0
    if ! { mkdir -p "${file%/*}" && printf '%d\n' "$1" >"$file"; } 2>/dev/null; then
        red "dwm-brightness: could not record the level in $file"
    fi
}

# apply() takes the nightlight path itself while that daemon runs.
sync_level() {
    local file pct
    backlight_info >/dev/null && return 0
    file="$(level_file)" || return 0
    pct="$(cat "$file" 2>/dev/null || true)"
    [[ "$pct" =~ ^[0-9]+$ ]] || return 0
    apply "$pct" >/dev/null
}

# Every connected output that is ON. Matching $2 exactly avoids the
# "disconnected" trap that a bare /connected/ pattern walks into; the
# WxH+X+Y geometry is what a switched-off screen lacks ("Virtual-2 connected
# (normal left ...)"), and xrandr refuses its --brightness, which made every
# change exit 1 while it was off. `sync` gives it the level once it is on.
outputs() {
    xrandr 2>/dev/null | awk '$2 == "connected" && / [0-9]+x[0-9]+\+[0-9]+\+[0-9]+( |$)/ { print $1 }'
}

# Brightness of the first connected output, as an integer percent.
#
# Read per-output rather than by grabbing the first "Brightness:" line in
# the file: outputs can and do disagree (a dev box here sat at 0.45 and 0.0
# simultaneously), and disconnected ones carry the property too. Tracking
# the current output header and only trusting connected ones is what makes
# the answer meaningful. No awk `exit` — that would SIGPIPE the producer
# and trip pipefail.
current() {
    local raw val info
    if info="$(backlight_info)"; then
        val="$(cut -d, -f4 <<<"$info")"
        val="${val%\%}"
        [[ "$val" =~ ^[0-9]+$ ]] || {
            red "dwm-brightness: brightnessctl printed '$info', expected a percent in field 4"
            return 1
        }
        printf '%d\n' "$val"
        return 0
    fi
    if nightlight_active; then
        val="$(cat "$(nightlight_file)" 2>/dev/null || true)"
        [[ "$val" =~ ^[0-9]+$ ]] || val=$MAX
        printf '%d\n' "$val"
        return 0
    fi
    # `|| true` is deliberate: under `set -e` a failing command substitution
    # in an assignment aborts the script with no message at all, so a dead X
    # server would make this exit 1 silently. Capture, then diagnose.
    raw="$(xrandr --verbose 2>/dev/null || true)"
    if [[ -z "$raw" ]]; then
        red "dwm-brightness: xrandr returned nothing — is DISPLAY set and X running?"
        return 1
    fi
    val="$(printf '%s\n' "$raw" | awk '
        /^[^[:space:]]/ { conn = ($2 == "connected") }
        conn && !found && /^[[:space:]]*Brightness:/ { val = $2; found = 1 }
        END { if (found) print val; else print "1.0" }
    ')"
    awk -v v="$val" 'BEGIN { printf "%d\n", (v * 100) + 0.5 }'
}

# Set every connected output to one value, converging displays that have
# drifted apart. Clamping is done here so `set` gets it too, not just the
# keybound up/down.
apply() {
    local pct="$1" out val found=0 failed=0
    if ((pct < MIN)); then pct=$MIN; fi
    if ((pct > MAX)); then pct=$MAX; fi
    if backlight_info >/dev/null; then
        # Fails when the user is not in the `video` group: said, never
        # silently swapped for gamma, which `get` would not read back.
        if ! brightnessctl --class=backlight -q set "${pct}%" 2>/dev/null; then
            red "dwm-brightness: brightnessctl could not set the backlight (you need to be in the video group)"
            return 1
        fi
        printf '%d\n' "$pct"
        return 0
    fi
    if nightlight_active; then
        local file
        file="$(nightlight_file)"
        mkdir -p "${file%/*}"
        printf '%d\n' "$pct" >"$file"
        dwm-nightlight apply || return 1
        store_level "$pct"
        printf '%d\n' "$pct"
        return 0
    fi
    val="$(awk -v p="$pct" 'BEGIN { printf "%.2f", p / 100 }')"

    while read -r out; do
        found=1
        if ! xrandr --output "$out" --brightness "$val" 2>/dev/null; then
            red "dwm-brightness: failed to set $out to $val"
            failed=1
        fi
    done < <(outputs)

    if ((found == 0)); then
        red "dwm-brightness: no connected outputs (or xrandr is unavailable)"
        return 1
    fi
    store_level "$pct"
    printf '%d\n' "$pct"
    return "$failed"
}

# dwm-idle-dim fades the gamma before the idle lock. The key press that runs
# this is input, so xss-lock is already killing it: wait (1 s at most) for
# its restore, or `current` reads the dimmed level and the change stores it.
# Its marker holds its pid until the restore is done.
await_undim() {
    local marker pid i
    marker="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-${HOME:-/nonexistent}/.cache}}/dots/idle-dim.pid"
    for ((i = 0; i < 20; i++)); do
        { read -r pid <"$marker"; } 2>/dev/null || return 0
        [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null || return 0
        sleep 0.05
    done
}

# Relative change. Reading the current value has to succeed before anything is
# written: inlining `apply "$(($(current) + STEP))"` would carry on with an
# empty reading and clamp the display to MIN when only the read had failed.
adjust() {
    local cur
    await_undim
    cur="$(current)" || return 1
    apply "$((cur + $1))"
}

case "${1:-}" in
    get) current ;;
    mode) mode ;;
    sync) sync_level ;;
    up) adjust "$STEP" ;;
    down) adjust "-$STEP" ;;
    set)
        if [[ -z "${2:-}" || ! "$2" =~ ^[0-9]+$ ]]; then
            red "dwm-brightness: set needs an integer percent"
            usage >&2
            exit 1
        fi
        await_undim
        apply "$2"
        ;;
    -h | --help)
        usage
        ;;
    *)
        red "dwm-brightness: unknown command '${1:-}'"
        usage >&2
        exit 1
        ;;
esac
