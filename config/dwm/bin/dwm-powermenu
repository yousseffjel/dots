#!/usr/bin/env bash
# dwm-powermenu — dmenu-driven power/session menu (lock/logout/suspend/reboot/shutdown,
# plus a power "profile" entry on a laptop with power-profiles-daemon — dwm-power).
# Colors/font mirror suckless/dwm/config.def.h's dmenucmd theme.
set -euo pipefail

# --help answers before anything opens a menu (tests/dwm-help.sh).
case "${1:-}" in
    -h | --help)
        echo "usage: dwm-powermenu — lock, logout, suspend, reboot, shutdown, and power profile on a laptop (Super+Shift+x)"
        exit 0
        ;;
esac

# Colours are deliberately NOT passed: dmenu reads them from the X
# resource database (dmenu.background/foreground/selbackground/
# selforeground), and explicit -nb/-nf/-sb/-sf flags would override the
# theme. Falls back to dmenu's compiled defaults when unthemed.
FONT="monospace:size=10"
DMENU_OPTS=(-i -fn "$FONT")

confirm() {
    local answer
    answer=$(printf '%s\n' no yes | dmenu "${DMENU_OPTS[@]}" -l 2 -p "$1?") || return 1
    [[ "$answer" == "yes" ]]
}

entries=(lock logout suspend reboot shutdown)
# "profile" only where a power-profiles service answers: power-profiles-daemon,
# which dots installs on laptops only (scope-h). A desktop's menu is unchanged.
if command -v dwm-power >/dev/null 2>&1 && dwm-power available 2>/dev/null; then
    entries+=(profile)
fi
choice=$(printf '%s\n' "${entries[@]}" \
    | dmenu "${DMENU_OPTS[@]}" -l "${#entries[@]}" -p "power>") || exit 0

case "$choice" in
    # dwm-lock, not slock directly: it routes through logind while the
    # xss-lock daemon is up, and falls back to slock when it is not.
    # Super+Shift+l takes the same path.
    lock)     exec dwm-lock ;;
    logout)   pkill -TERM -x dwm ;;
    # elogind's loginctl, not systemctl (Void has no systemd): the same
    # verbs, and polkit lets the active session's user run them unprompted
    # (org.freedesktop.login1.{suspend,reboot,power-off}: allow_active yes,
    # read in Void's elogind-252.39_1).
    suspend)  loginctl suspend ;;
    reboot)   confirm "reboot"   && loginctl reboot ;;
    shutdown) confirm "shutdown" && loginctl poweroff ;;
    profile)  exec dwm-power ;;
esac
