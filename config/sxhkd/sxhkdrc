# sxhkdrc — hotkeys that dwm does not handle.
#
# OWNERSHIP. dwm and sxhkd both call XGrabKey() on the root window, and a
# keysym+modifier claimed by both goes to whichever grabbed it first — the
# loser silently gets nothing, with no error anywhere. So the two sets must
# stay disjoint:
#
#   dwm   (suckless/dwm/config.def.h, compiled in) — window management:
#         tags, layouts, focus, monitors, scratchpads, quit/restart, plus
#         Super+space (dwm-apps), Super+Return (terminal), Super+Shift+x
#         (powermenu), Super+v (clipmenu) and Super+grave (the drop-down
#         terminal, a dwm function rather than a spawn).
#   sxhkd (this file, reloadable) — everything else: media, volume, mic,
#         brightness, theming, screenshots, app launchers.
#
# Both live in the Super space: dwm's MODKEY is Mod4Mask (Super) since
# 2026-10-12, so every Super chord here must avoid every MODKEY chord in
# keys[] — h/j/k/l, s, q, b, d, i, m, t, f, space, comma, period, the digits.
# tests/key-collisions.sh reads both files and fails the build on an overlap;
# run it before adding a binding rather than checking by eye.
#
# Changing dwm's bindings needs a recompile; changing this file needs only
# Super+Ctrl+r. That asymmetry is the reason the split exists.
#
# Commands run through $SXHKD_SHELL (falling back to $SHELL) with -c, so
# shell operators like && work. dwm-* helpers resolve through PATH:
# ~/.config/dwm/bin is added by config/zsh/.zshenv.

# --- media -------------------------------------------------------------
# playerctl talks MPRIS over D-Bus, so these reach any compliant player
# (firefox, mpv with the script, spotify) with no per-app configuration.
# They no-op quietly when nothing is playing.

XF86AudioPlay
	playerctl play-pause

XF86AudioNext
	playerctl next

XF86AudioPrev
	playerctl previous

XF86AudioStop
	playerctl stop

# --- volume and microphone ---------------------------------------------
# The trailing pkill is load-bearing, not a refresh nicety. The vol and mic
# status blocks run at interval 0 — signal-driven only, never polled, which
# is what keeps them off the CPU (roster Epic sub-task 7). Without the
# signal the bar simply never updates. Signals: mic RTMIN+7, vol RTMIN+8.
#
# Raising the volume also unmutes, matching what a hardware volume key does
# on every other desktop. Lowering deliberately does not — turning a muted
# system down should not make it audible.
#
# dwm-osd then shows a pop-up with the new level. It follows a `;`, not `&&`:
# it only reads, so it runs even when dwmblocks is not there to signal.
# dwm-sound plays the volume tick last (`dwm-sound off` silences it; mute
# makes no tick, so a mute key never startles).

XF86AudioRaiseVolume
	pamixer --unmute --increase 5 && pkill -RTMIN+8 dwmblocks; dwm-osd volume; dwm-sound audio-volume-change

XF86AudioLowerVolume
	pamixer --decrease 5 && pkill -RTMIN+8 dwmblocks; dwm-osd volume; dwm-sound audio-volume-change

XF86AudioMute
	pamixer --toggle-mute && pkill -RTMIN+8 dwmblocks; dwm-osd volume

XF86AudioMicMute
	pamixer --default-source --toggle-mute && pkill -RTMIN+7 dwmblocks; dwm-osd mic

# --- brightness --------------------------------------------------------
# Software gamma via xrandr, NOT a hardware backlight — this target is a
# desktop GPU with no /sys/class/backlight (roster Epic locked decision
# 12). It dims the output signal; the monitor's lamp stays at full power.
# dwm-brightness owns the clamping and the multi-output walk; sub-task 7's
# status block reads the same value back with `dwm-brightness get`.

XF86MonBrightnessUp
	dwm-brightness up && pkill -RTMIN+6 dwmblocks; dwm-osd brightness

XF86MonBrightnessDown
	dwm-brightness down && pkill -RTMIN+6 dwmblocks; dwm-osd brightness

# Night light on/off (dwm-nightlight). Its daemon also owns the gamma while
# it runs, so the two brightness keys above go through it — see the header
# of config/dwm/bin/dwm-nightlight.
super + n
	dwm-nightlight toggle

# --- notifications -----------------------------------------------------
# Focus mode (do not disturb): a paused dunst holds new notifications and
# shows them all on resume. The bell block (signal 12,
# suckless/dwmblocks/scripts/dwm-dnd) shows the state; the pkill makes it
# follow at once instead of at its next poll. Right-clicking the bell does
# the same.
super + shift + n
	dunstctl set-paused toggle; pkill -RTMIN+12 dwmblocks
# Notification centre (config/dwm/bin/dwm-notify): dunst's history in a
# dmenu list under the bar's right end — open or delete one, clear all,
# toggle focus mode. Left-clicking the bell opens it too. Until 2026-10-15
# this key was `dunstctl history-pop`; "open" in the list re-shows any one.
super + ctrl + n
	dwm-notify

# --- theming -----------------------------------------------------------
# These live here rather than in dwm on purpose: config.def.h shipped them
# commented out because enabling them meant a rebuild. As sxhkd bindings
# they are simply active, and editing them costs a reload instead of a
# recompile. See docs/THEMING.md for what each one drives.

super + shift + w
	dwm-wallpaper --select

super + w
	dwm-wallpaper --random

# Super+t is dwm's tiled layout, so the theme menu takes Shift.
super + shift + t
	dwm-theme

# --- applications ------------------------------------------------------
# Only the two daily drivers get a dedicated key. Everything else is one
# Super+space away through dwm-apps, and a launcher key per application is how a
# keymap becomes unmemorable.

# Super+b is dwm's bar toggle, so the browser takes Shift.
super + shift + b
	firefox

super + e
	thunar

# --- sxhkd itself ------------------------------------------------------
# Reload the config in place. USR1 makes the running daemon re-read this
# file without dropping its grabs or losing the process.

super + ctrl + r
	pkill -USR1 -x sxhkd

# --- screenshot --------------------------------------------------------
# Print opens the full two-level menu: mode (full / monitor / window /
# region; monitor is the one under the pointer), then
# destination (clipboard / file / both). The rest are fast paths, no prompts:
#
#   Shift+Print — drag a region, straight to the clipboard.
#   Super+a is the same, but deliberately NOT here: a grabbed key takes the
#     focus off the window while held, and a browser closes an open dropdown
#     on that. dwm-shotkey (autostart.sh) reads it without a grab instead.
#     Binding it here again would bring the grab back.
#   Super+Shift+a — region to clipboard after 3 s: press it, then open the
#     menu (for the rare one that closes even on an ungrabbed key).
#     Deliberately no file: region grabs are overwhelmingly paste-once, and a
#     key that silently fills ~/Pictures/screenshots is one you end up
#     cleaning up after.
#   Super+Alt+p — the whole screen, to the clipboard AND saved as a file.

Print
	dwm-screenshot

super + shift + a
	dwm-screenshot --delay 3 --region --clipboard

shift + Print
	dwm-screenshot --region --clipboard

super + alt + p
	dwm-screenshot --full --both

# --- screen recording --------------------------------------------------
# One key toggles: with nothing recording it asks full | monitor | region and starts;
# while recording, the same key stops it. Files go to ~/Videos/recordings.
# (super + ctrl + r is the sxhkd reload.)
super + r
	dwm-record

# --- lock --------------------------------------------------------------
# dwm-lock rather than slock directly. While the xss-lock daemon is running
# this goes through `loginctl lock-session`, so logind's own record of the
# session stays truthful and the idle timer, suspend and this key all end in
# the same locker. With no daemon it calls slock itself, so the key still
# works on a box where xss-lock never installed.
#
# The daemon is started from ~/.local/share/dwm/autostart.sh, not from here —
# see scripts/install-session.sh.
#
# Super+Shift+l, not the usual Super+l: l is dwm's grow-the-master key.
super + shift + l
	dwm-lock

# --- power profile -----------------------------------------------------------
# power-saver / balanced / performance, through power-profiles-daemon — installed on
# laptops only (packages/laptop.lst). On a desktop the key says so instead.
super + shift + p
	dwm-power

# --- colour and displays -----------------------------------------------------
# Super+d is dwm's fewer-masters key, so the display menu takes Shift.

# Sample the pixel under the pointer; hex to the clipboard, swatch via dunst.
super + c
	dwm-colorpicker

# Monitor layout menu: autorandr profiles when saved, then presets derived
# from whatever xrandr reports as connected.
super + shift + d
	dwm-display

# --- help --------------------------------------------------------------
# Every keybinding in a searchable dmenu list, read from KEYBINDINGS.md.
super + slash
	dwm-keys

# --- emoji -------------------------------------------------------------
# Pick an emoji in dmenu; it is copied to the clipboard. Other desktops use
# Super+. but that is dwm's next-monitor key; Super+; is the usual second
# choice (it is the emoji key on Windows alongside Super+.).
super + semicolon
	dwm-emoji
