# themes/tokyo-night — static Tokyo Night-flavoured dark palette.
#
# Generated by scripts/theme/colorgen.sh from a seed image of four equal
# blocks — night background #1a1b26, red #f7768e, blue #7aa2f7 and green
# #9ece6a — then committed as a static palette. Produced by the real
# engine rather than hand-written hex, so it is guaranteed to parse and to
# carry every key a template can reference (89 dcol_* keys).
#
# The four dcol_pry values below are those seed colours verbatim; every
# accent ramp and text colour is this engine dark curve rather than
# anything Tokyo Night publishes. Tokyo Night-flavoured, not a port.
# Upstream: folke/tokyonight.nvim (Apache-2.0). See CREDITS.md.
#
# Applied with:  scripts/theme/theme-apply.sh tokyo-night
# Dark only — this project has no light mode.
#
dcol_mode="dark"
dcol_pry1="1A1B26"
dcol_pry1_rgba="26,27,38,255"
dcol_txt1="FFFFFF"
dcol_txt1_rgba="255,255,255,255"
dcol_1xa1="292C52"
