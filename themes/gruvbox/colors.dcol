# themes/gruvbox — static Gruvbox-flavoured dark palette.
#
# Generated by scripts/theme/colorgen.sh from a seed image of four equal
# blocks — dark0 #282828, bright red #fb4934, bright aqua #83a598 and
# bright green #b8bb26 — then committed as a static palette. Produced by
# the real engine rather than hand-written hex, so it is guaranteed to
# parse and to carry every key a template can reference (89 dcol_* keys).
#
# The four dcol_pry values below are those seed colours verbatim; every
# accent ramp and text colour is this engine dark curve rather than
# anything Gruvbox publishes. Gruvbox-flavoured, not a faithful port.
# Upstream: morhetz/gruvbox (MIT/X11). See CREDITS.md.
#
# Applied with:  scripts/theme/theme-apply.sh gruvbox
# Dark only — this project has no light mode.
#
dcol_mode="dark"
dcol_pry1="282828"
dcol_pry1_rgba="40,40,40,255"
dcol_txt1="FFFFFF"
dcol_txt1_rgba="255,255,255,255"
